# ── power-ppt env vars ────────────────────────────────────────────────
# Copia a .env y completa. NO commitear .env.

# Password compartido del equipo Goberna para acceder al workspace.
GOBERNA_PASSWORD=cambiame

# Secret de 32+ chars para firmar cookies de sesión.
# Generar con: openssl rand -hex 32
SESSION_SECRET=cambiame-32-chars-min-please

NODE_ENV=production
