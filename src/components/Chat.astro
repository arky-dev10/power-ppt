---
// Chat lateral con Claude. Embebible en cualquier página.
// Pasar `candidateSlug` para que Claude tenga contexto del candidato actual.
const { candidateSlug = null, title = 'Chat con Claude', storageKey = 'chat-default' } = Astro.props;
---

<section class="chat-panel" data-slug={candidateSlug ?? ''} data-storage-key={storageKey}>
  <header class="chat-header">
    <div class="chat-title">
      <span class="dot"></span>
      {title}
    </div>
    <button type="button" class="chat-clear" title="Limpiar historial">⌫</button>
  </header>

  <div class="chat-log" aria-live="polite"></div>

  <form class="chat-form">
    <textarea
      class="chat-input"
      placeholder="Escribe a Claude… (Enter envía · Shift+Enter salto de línea)"
      rows="2"
      autocomplete="off"
    ></textarea>
    <button type="submit" class="chat-send" disabled>Enviar</button>
  </form>
</section>

<style>
  .chat-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    background: rgba(10, 21, 56, 0.5);
    border: 1px solid rgba(251, 192, 45, 0.12);
    border-radius: 12px;
    overflow: hidden;
    font-family: 'Inter', system-ui, sans-serif;
  }
  .chat-header {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    background: rgba(5, 10, 30, 0.7);
    border-bottom: 1px solid rgba(248, 250, 252, 0.05);
  }
  .chat-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 6px #4ade80aa; }
  .chat-clear {
    font-size: 14px;
    color: #475569;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .chat-clear:hover { color: #f87171; background: rgba(248, 113, 113, 0.08); }

  .chat-log {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    scroll-behavior: smooth;
    font-size: 0.86rem;
    color: #cbd5e1;
    line-height: 1.55;
  }
  .chat-log::-webkit-scrollbar { width: 6px; }
  .chat-log::-webkit-scrollbar-thumb { background: rgba(251, 192, 45, 0.15); border-radius: 3px; }

  .msg {
    max-width: 92%;
    padding: 0.6rem 0.85rem;
    border-radius: 9px;
    word-wrap: break-word;
  }
  .msg-user {
    align-self: flex-end;
    background: rgba(251, 192, 45, 0.12);
    border: 1px solid rgba(251, 192, 45, 0.25);
    color: #f8fafc;
  }
  .msg-assistant {
    align-self: flex-start;
    background: rgba(5, 10, 30, 0.5);
    border: 1px solid rgba(248, 250, 252, 0.05);
  }
  .msg-tool {
    align-self: flex-start;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.05em;
    background: rgba(96, 165, 250, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.18);
    color: #93c5fd;
    padding: 0.4rem 0.7rem;
  }
  .msg-tool.error {
    background: rgba(248, 113, 113, 0.08);
    border-color: rgba(248, 113, 113, 0.25);
    color: #fca5a5;
  }
  .msg-error {
    align-self: stretch;
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.3);
    color: #fca5a5;
    font-size: 0.78rem;
  }

  /* Markdown rendering */
  .msg-assistant :global(p) { margin: 0 0 0.4rem 0; }
  .msg-assistant :global(p:last-child) { margin-bottom: 0; }
  .msg-assistant :global(code) {
    background: rgba(251, 192, 45, 0.08);
    color: #fbc02d;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
  }
  .msg-assistant :global(pre) {
    background: rgba(5, 10, 30, 0.7);
    border: 1px solid rgba(248, 250, 252, 0.05);
    border-radius: 6px;
    padding: 0.6rem 0.8rem;
    overflow-x: auto;
    font-size: 0.78rem;
  }
  .msg-assistant :global(ul), .msg-assistant :global(ol) { margin: 0.25rem 0 0.4rem 1.2rem; }
  .msg-assistant :global(strong) { color: #f8fafc; }

  .typing { color: #475569; font-style: italic; font-size: 0.78rem; }

  .chat-form {
    flex: 0 0 auto;
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem;
    background: rgba(5, 10, 30, 0.5);
    border-top: 1px solid rgba(248, 250, 252, 0.05);
  }
  .chat-input {
    flex: 1;
    background: rgba(10, 21, 56, 0.6);
    border: 1px solid rgba(248, 250, 252, 0.08);
    border-radius: 8px;
    color: #e2e8f0;
    font-family: inherit;
    font-size: 0.86rem;
    padding: 0.55rem 0.7rem;
    resize: none;
    outline: none;
    transition: border-color 0.15s;
  }
  .chat-input:focus { border-color: rgba(251, 192, 45, 0.4); }
  .chat-send {
    align-self: flex-end;
    background: linear-gradient(90deg, #fbc02d, #ff9500);
    color: #050a1e;
    border: none;
    border-radius: 8px;
    padding: 0.55rem 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.05s;
  }
  .chat-send:disabled { opacity: 0.35; cursor: not-allowed; }
  .chat-send:active:not(:disabled) { transform: translateY(1px); }
</style>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  marked.setOptions({ breaks: true, gfm: true });

  document.querySelectorAll<HTMLElement>('.chat-panel').forEach((panel) => {
    const slug = panel.dataset.slug || null;
    const storageKey = `power-ppt:${panel.dataset.storageKey || 'chat'}`;
    const log = panel.querySelector<HTMLElement>('.chat-log')!;
    const form = panel.querySelector<HTMLFormElement>('.chat-form')!;
    const input = panel.querySelector<HTMLTextAreaElement>('.chat-input')!;
    const sendBtn = panel.querySelector<HTMLButtonElement>('.chat-send')!;
    const clearBtn = panel.querySelector<HTMLButtonElement>('.chat-clear')!;

    type StoredMsg = { role: 'user' | 'assistant' | 'tool' | 'error'; content: string; toolName?: string; toolError?: boolean };
    const history: StoredMsg[] = JSON.parse(localStorage.getItem(storageKey) || '[]');

    const save = () => localStorage.setItem(storageKey, JSON.stringify(history.slice(-100)));

    function renderMd(text: string): string {
      const dirty = marked.parse(text) as string;
      return DOMPurify.sanitize(dirty);
    }

    function appendMsg(m: StoredMsg, store = true) {
      const el = document.createElement('div');
      el.className = 'msg msg-' + (m.role === 'user' ? 'user' : m.role === 'tool' ? 'tool' : m.role === 'error' ? 'error' : 'assistant');
      if (m.role === 'tool' && m.toolError) el.classList.add('error');
      if (m.role === 'assistant' || m.role === 'error') {
        el.innerHTML = renderMd(m.content);
      } else if (m.role === 'tool') {
        el.textContent = `→ ${m.toolName ?? 'tool'}${m.content ? ' ' + m.content : ''}`;
      } else {
        el.textContent = m.content;
      }
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      if (store) { history.push(m); save(); }
      return el;
    }

    function appendTyping(): HTMLElement {
      const el = document.createElement('div');
      el.className = 'msg msg-assistant typing';
      el.textContent = 'Claude está pensando…';
      log.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return el;
    }

    function shortInput(input: any): string {
      if (!input || typeof input !== 'object') return '';
      const keys = Object.keys(input);
      if (!keys.length) return '';
      return ' ' + keys.slice(0, 3).map((k) => `${k}=${JSON.stringify(input[k]).slice(0, 60)}`).join(' · ');
    }

    function prettyToolName(n: string): string {
      return n.replace(/^mcp__power-ppt__/, '').replace(/_/g, ' ');
    }

    // Rehydrate history
    history.forEach((m) => appendMsg(m, false));
    log.scrollTop = log.scrollHeight;

    input.addEventListener('input', () => { sendBtn.disabled = !input.value.trim(); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
    });

    clearBtn.addEventListener('click', () => {
      history.length = 0; save(); log.innerHTML = '';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const prompt = input.value.trim();
      if (!prompt) return;
      input.value = '';
      sendBtn.disabled = true;
      input.disabled = true;

      appendMsg({ role: 'user', content: prompt });
      const typingEl = appendTyping();
      let currentAssistant: HTMLElement | null = null;
      let buffer = '';

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt, candidateSlug: slug }),
        });
        if (!res.ok || !res.body) throw new Error(`HTTP ${res.status}`);

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let raw = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          raw += decoder.decode(value, { stream: true });

          // Parse SSE events split by blank line
          const parts = raw.split(/\r?\n\r?\n/);
          raw = parts.pop() ?? '';

          for (const part of parts) {
            const lines = part.split(/\r?\n/);
            const event = lines.find((l) => l.startsWith('event: '))?.slice(7).trim() ?? 'message';
            const dataLine = lines.find((l) => l.startsWith('data: '))?.slice(6) ?? '';
            if (!dataLine) continue;
            let data: any;
            try { data = JSON.parse(dataLine); } catch { continue; }

            if (event === 'text') {
              typingEl.remove();
              if (!currentAssistant) {
                buffer = '';
                currentAssistant = document.createElement('div');
                currentAssistant.className = 'msg msg-assistant';
                log.appendChild(currentAssistant);
              }
              buffer += data.text;
              currentAssistant.innerHTML = renderMd(buffer);
              log.scrollTop = log.scrollHeight;
            } else if (event === 'tool_use') {
              typingEl.remove();
              if (currentAssistant && buffer) {
                history.push({ role: 'assistant', content: buffer }); save();
                currentAssistant = null;
                buffer = '';
              }
              const name = data.name as string;
              if (name === 'ToolSearch') continue; // hide noise
              appendMsg({ role: 'tool', content: shortInput(data.input), toolName: prettyToolName(name) });
            } else if (event === 'tool_result') {
              if (data.is_error) {
                appendMsg({ role: 'tool', content: '↳ error: ' + (data.text ?? '').slice(0, 200), toolName: '✗', toolError: true });
              }
            } else if (event === 'error') {
              appendMsg({ role: 'error', content: '⚠ ' + (data.message ?? 'error') });
            } else if (event === 'done') {
              if (currentAssistant && buffer) { history.push({ role: 'assistant', content: buffer }); save(); }
              currentAssistant = null;
              if (data.is_error) appendMsg({ role: 'error', content: '⚠ Claude reportó error' });
            }
          }
        }
      } catch (err: any) {
        typingEl.remove();
        appendMsg({ role: 'error', content: '⚠ ' + (err?.message ?? 'Error de conexión') });
      } finally {
        input.disabled = false;
        sendBtn.disabled = !input.value.trim();
        input.focus();
      }
    });
  });
</script>
