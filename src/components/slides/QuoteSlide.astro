---
const { slide } = Astro.props;
---

<section class="slide" style="background:#050a1e;">
  <!-- Ambient -->
  <div class="absolute inset-0 pointer-events-none" style="
    background:
      radial-gradient(ellipse 60% 55% at 20% 50%, rgba(20,32,88,0.7) 0%, transparent 55%),
      radial-gradient(ellipse 40% 40% at 80% 50%, rgba(251,192,45,0.04) 0%, transparent 55%);
  "></div>

  <!-- Large decorative quote mark -->
  <div class="absolute pointer-events-none" style="
    font-family:'Inter Tight',sans-serif; font-size:28rem; font-weight:900; line-height:1;
    color:rgba(251,192,45,0.04); top:-3rem; left:3rem; user-select:none; letter-spacing:-0.05em;
  ">"</div>

  <div class="absolute flex flex-col justify-center"
    style="top:70px; bottom:24px; left:60px; right:60px; max-width:52rem;">

    {slide.kicker && (
      <p data-anim="fade" data-delay="0"
        style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.3em; text-transform:uppercase; color:#fbc02d; margin-bottom:2rem;">
        {slide.kicker}
      </p>
    )}

    <!-- Quote text -->
    <blockquote data-anim data-delay="60"
      style="font-family:'Inter Tight','Inter',sans-serif; font-weight:700; font-size:clamp(1.6rem,3.2vw,2.4rem); line-height:1.3; letter-spacing:-0.02em; color:#f8fafc; margin:0;">
      "{slide.quote}"
    </blockquote>

    <!-- Separator + attribution -->
    <div data-anim data-delay="200" style="display:flex; align-items:center; gap:1.25rem; margin-top:2rem;">
      <div style="width:32px; height:2px; background:linear-gradient(90deg,#fbc02d,#ff9500); border-radius:1px; flex-shrink:0;"></div>
      <div>
        {slide.attribution && (
          <p style="font-family:'Inter',sans-serif; font-size:0.9rem; font-weight:600; color:#fbc02d; letter-spacing:0.02em;">
            {slide.attribution}
          </p>
        )}
        {slide.context && (
          <p style="font-family:'Inter',sans-serif; font-size:0.8rem; color:#64748b; margin-top:0.15rem;">
            {slide.context}
          </p>
        )}
      </div>
    </div>
  </div>
</section>
