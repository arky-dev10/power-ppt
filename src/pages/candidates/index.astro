---
import SelectorLayout from '../../layouts/SelectorLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const candidatesDir = path.join(process.cwd(), 'candidates');

type CandidateCard = {
  slug: string;
  nombre: string;
  cargo: string;
  territorio: string;
  año: string;
  tipo: string;
  color: string;
  fase2Estado: string;
  modified: Date;
};

const CARGO_LABEL: Record<string, string> = {
  alcalde_distrital:   'Alcalde Distrital',
  alcalde_provincial:  'Alcalde Provincial',
  regidor:             'Regidor',
  consejero_regional:  'Consejero Regional',
  gobernador_regional: 'Gobernador Regional',
  congresista:         'Congresista',
  presidente:          'Presidente',
};

const TIPO_COLOR: Record<string, string> = {
  'candidato-propio': '#4ade80',
  rival:              '#f87171',
  aliado:             '#60a5fa',
};
const TIPO_LABEL: Record<string, string> = {
  'candidato-propio': 'Propio',
  rival:              'Rival',
  aliado:             'Aliado',
};

const F2_COLOR: Record<string, string> = {
  generada:  '#4ade80',
  pendiente: '#475569',
};

const candidates: CandidateCard[] = fs.existsSync(candidatesDir)
  ? fs.readdirSync(candidatesDir, { withFileTypes: true })
      .filter(d => d.isDirectory() && !d.name.startsWith('_') && !d.name.startsWith('.'))
      .map(d => {
        const candPath = path.join(candidatesDir, d.name, 'candidate.json');
        if (!fs.existsSync(candPath)) return null;
        try {
          const c = JSON.parse(fs.readFileSync(candPath, 'utf-8'));
          const año = c.postulacion?.fecha_eleccion
            ? String(new Date(c.postulacion.fecha_eleccion).getFullYear())
            : '';
          const stat = fs.statSync(candPath);
          return {
            slug:        d.name,
            nombre:      c.candidato?.nombre_completo ?? d.name,
            cargo:       CARGO_LABEL[c.postulacion?.cargo_codigo] ?? c.postulacion?.cargo_codigo ?? '—',
            territorio:  c.postulacion?.nombre_territorio ?? '—',
            año,
            tipo:        c.candidato?.tipo ?? 'candidato-propio',
            color:       c.branding?.color_primario ?? '#fbc02d',
            fase2Estado: c.fase_2?.estado ?? 'pendiente',
            modified:    stat.mtime,
          };
        } catch { return null; }
      })
      .filter(Boolean) as CandidateCard[]
  : [];

candidates.sort((a, b) => b.modified.getTime() - a.modified.getTime());

function timeAgo(date: Date) {
  const diff = Date.now() - date.getTime();
  const m = Math.floor(diff / 60000);
  if (m < 60) return `hace ${m}m`;
  const h = Math.floor(m / 60);
  if (h < 24) return `hace ${h}h`;
  return `hace ${Math.floor(h / 24)}d`;
}
---

<SelectorLayout>
  <!-- Nav tabs -->
  <div style="display:flex; gap:1rem; margin-bottom:2rem; flex-wrap:wrap;">
    <a href="/" style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; padding:0.4rem 0.9rem; border-radius:5px; border:1px solid rgba(248,250,252,0.08); color:#64748b; text-decoration:none;"
      onmouseenter="this.style.borderColor='rgba(251,192,45,0.2)'; this.style.color='#94a3b8'"
      onmouseleave="this.style.borderColor='rgba(248,250,252,0.08)'; this.style.color='#64748b'">
      Presentaciones
    </a>
    <a href="/candidates" style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; padding:0.4rem 0.9rem; border-radius:5px; border:1px solid rgba(251,192,45,0.35); color:#fbc02d; text-decoration:none;">
      Candidatos
    </a>
    <a href="/vetting" style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; padding:0.4rem 0.9rem; border-radius:5px; border:1px solid rgba(248,250,252,0.08); color:#64748b; text-decoration:none;"
      onmouseenter="this.style.borderColor='rgba(251,192,45,0.2)'; this.style.color='#94a3b8'"
      onmouseleave="this.style.borderColor='rgba(248,250,252,0.08)'; this.style.color='#64748b'">
      Perfiles 5N
    </a>
    <a href="/diagnostics" style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; padding:0.4rem 0.9rem; border-radius:5px; border:1px solid rgba(248,250,252,0.08); color:#64748b; text-decoration:none;"
      onmouseenter="this.style.borderColor='rgba(251,192,45,0.2)'; this.style.color='#94a3b8'"
      onmouseleave="this.style.borderColor='rgba(248,250,252,0.08)'; this.style.color='#64748b'">
      Diagnóstico Territorial
    </a>
  </div>

  <!-- Header -->
  <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:2rem; gap:1rem; flex-wrap:wrap;">
    <div>
      <p style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.3em; text-transform:uppercase; color:#fbc02d; margin-bottom:0.5rem;">
        Modo Candidato
      </p>
      <h1 style="font-family:'Inter Tight',sans-serif; font-weight:900; font-size:2rem; letter-spacing:-0.02em; color:#f8fafc; margin-bottom:0.3rem;">
        Candidatos
      </h1>
      <p style="font-size:0.85rem; color:#64748b;">
        Onboarding Fase 1 + Presentación Fase 2 auto-generada.
      </p>
    </div>
    <a href="/candidates/new"
      style="display:inline-flex; align-items:center; gap:0.5rem; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; padding:0.65rem 1.4rem; border-radius:7px; background:rgba(251,192,45,0.12); border:1px solid rgba(251,192,45,0.4); color:#fbc02d; text-decoration:none; white-space:nowrap; transition:all 0.2s;"
      onmouseenter="this.style.background='rgba(251,192,45,0.2)'; this.style.borderColor='rgba(251,192,45,0.7)'"
      onmouseleave="this.style.background='rgba(251,192,45,0.12)'; this.style.borderColor='rgba(251,192,45,0.4)'">
      + Nuevo candidato
    </a>
  </div>

  <!-- Grid candidatos -->
  {candidates.length > 0 ? (
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:1rem; margin-bottom:3rem;">
      {candidates.map(c => (
        <a href={`/candidates/${c.slug}`}
          style={`display:flex; flex-direction:column; gap:0; background:rgba(10,21,56,0.6); border:1px solid rgba(251,192,45,0.12); border-radius:14px; overflow:hidden; text-decoration:none; color:inherit; transition:border-color 0.2s, transform 0.2s;`}
          onmouseenter="this.style.borderColor='rgba(251,192,45,0.35)'; this.style.transform='translateY(-2px)'"
          onmouseleave={`this.style.borderColor='rgba(251,192,45,0.12)'; this.style.transform='translateY(0)'`}>

          <!-- Color strip con el color del candidato -->
          <div style={`height:4px; background:${c.color}; opacity:0.8;`}></div>

          <div style="padding:1.4rem 1.5rem; display:flex; flex-direction:column; gap:0.5rem; flex:1;">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:0.75rem;">
              <h2 style="font-family:'Inter Tight',sans-serif; font-weight:800; font-size:1rem; color:#f8fafc; line-height:1.25; flex:1;">
                {c.nombre}
              </h2>
              <span style={`flex-shrink:0; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; padding:0.2rem 0.55rem; border-radius:3px; background:${TIPO_COLOR[c.tipo] ?? '#64748b'}22; color:${TIPO_COLOR[c.tipo] ?? '#64748b'};`}>
                {TIPO_LABEL[c.tipo] ?? c.tipo}
              </span>
            </div>

            <p style="font-size:0.78rem; color:#64748b; line-height:1.4;">
              {c.cargo} &middot; {c.territorio} {c.año}
            </p>

            <div style="display:flex; align-items:center; gap:0.5rem; margin-top:auto; padding-top:0.75rem; border-top:1px solid rgba(248,250,252,0.05);">
              <div style={`width:6px; height:6px; border-radius:50%; background:${F2_COLOR[c.fase2Estado] ?? '#475569'}; flex-shrink:0;`}></div>
              <span style={`font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; color:${F2_COLOR[c.fase2Estado] ?? '#475569'};`}>
                Fase 2 {c.fase2Estado}
              </span>
              <span style="font-size:0.72rem; color:#334155; margin-left:auto;">{timeAgo(c.modified)}</span>
              <span style="color:rgba(248,250,252,0.2); font-size:1rem;">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div style="background:rgba(10,21,56,0.4); border:1px dashed rgba(251,192,45,0.15); border-radius:14px; padding:3rem; text-align:center; margin-bottom:3rem;">
      <p style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.25em; text-transform:uppercase; color:#334155; margin-bottom:0.75rem;">
        Sin candidatos aún
      </p>
      <p style="font-size:0.85rem; color:#475569; line-height:1.6; margin-bottom:1.5rem;">
        Completá el formulario de Fase 1 para generar la primera presentación estratégica.
      </p>
      <a href="/candidates/new"
        style="display:inline-flex; align-items:center; gap:0.5rem; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.18em; text-transform:uppercase; padding:0.65rem 1.6rem; border-radius:7px; background:rgba(251,192,45,0.1); border:1px solid rgba(251,192,45,0.35); color:#fbc02d; text-decoration:none;">
        + Crear primer candidato
      </a>
    </div>
  )}

  <!-- Info del flujo -->
  <div style="background:rgba(5,10,30,0.8); border:1px solid rgba(248,250,252,0.05); border-radius:12px; padding:1.5rem;">
    <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:#334155; margin-bottom:1rem;">Flujo de trabajo</p>
    <div style="display:flex; flex-direction:column; gap:0.6rem;">
      {[
        ['Fase 1 Rápida', 'Formulario de 8 secciones — 15 minutos — genera presentación automáticamente'],
        ['Fase 1 Completa', 'Diagnóstico profundo — 5N (identidad) + ECD (territorio) — via Claude'],
        ['Fase 2 editable', 'Presentación estratégica auto-generada — editable slide a slide'],
      ].map(([label, desc]) => (
        <div style="display:grid; grid-template-columns:160px 1fr; gap:1rem; align-items:start;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:#475569; padding-top:0.1rem;">{label}</span>
          <span style="font-size:0.8rem; color:#64748b;">{desc}</span>
        </div>
      ))}
    </div>
  </div>
</SelectorLayout>
