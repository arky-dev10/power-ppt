---
// /candidates/new — Formulario Fase 1 (Modo Rápido)
const today = new Date().toISOString().slice(0, 10);
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nuevo candidato — Goberna</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@700;800;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --gold: #fbc02d;
      --gold-dim: rgba(251,192,45,0.12);
      --gold-border: rgba(251,192,45,0.25);
      --bg: #050a1e;
      --surface: rgba(10,21,56,0.6);
      --text: #f8fafc;
      --muted: #64748b;
      --border: rgba(248,250,252,0.08);
      --sidebar-w: 240px;
    }
    body { background: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; -webkit-font-smoothing: antialiased; }

    /* ── Layout ── */
    .layout { display: flex; min-height: 100vh; }
    .sidebar {
      width: var(--sidebar-w); flex-shrink: 0;
      background: rgba(5,10,30,0.95);
      border-right: 1px solid var(--border);
      display: flex; flex-direction: column;
      position: sticky; top: 0; height: 100vh; overflow-y: auto;
    }
    .sidebar-logo {
      padding: 1.5rem 1.25rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    .sidebar-logo a { text-decoration: none; display: flex; align-items: center; gap: 0.6rem; }
    .sidebar-logo span { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }

    .step-list { padding: 1rem 0; flex: 1; }
    .step-item {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.6rem 1.25rem;
      cursor: pointer; transition: background 0.15s;
      border-left: 2px solid transparent;
    }
    .step-item:hover { background: rgba(251,192,45,0.04); }
    .step-item.active { border-left-color: var(--gold); background: rgba(251,192,45,0.06); }
    .step-item.done .step-dot { background: #4ade80; }
    .step-item.active .step-dot { background: var(--gold); box-shadow: 0 0 8px rgba(251,192,45,0.5); }
    .step-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--border); flex-shrink: 0;
      transition: background 0.2s;
    }
    .step-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); transition: color 0.15s; }
    .step-item.active .step-label { color: var(--gold); }
    .step-item.done .step-label { color: #4ade80; }

    /* ── Main ── */
    .main { flex: 1; display: flex; flex-direction: column; min-width: 0; }

    .topbar {
      padding: 1rem 2.5rem;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 1.5rem;
      background: rgba(5,10,30,0.8); backdrop-filter: blur(8px);
      position: sticky; top: 0; z-index: 10;
    }
    .topbar-title { font-family: 'Inter Tight', sans-serif; font-weight: 800; font-size: 1rem; color: var(--text); }
    .topbar-step { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
    .progress-bar-wrap { flex: 1; height: 3px; background: rgba(248,250,252,0.06); border-radius: 2px; overflow: hidden; }
    .progress-bar-fill { height: 100%; background: linear-gradient(90deg, var(--gold), #ff9500); border-radius: 2px; transition: width 0.4s ease; }
    .pct-label { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--gold); min-width: 3ch; text-align: right; }

    /* ── Mode toggle ── */
    .mode-toggle {
      display: flex; gap: 0.5rem;
      background: rgba(5,10,30,0.8); border: 1px solid var(--border); border-radius: 7px;
      padding: 3px;
    }
    .mode-btn {
      font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase;
      padding: 0.35rem 0.8rem; border-radius: 5px; border: none; cursor: pointer;
      background: transparent; color: var(--muted); transition: all 0.15s;
    }
    .mode-btn.active { background: var(--gold-dim); color: var(--gold); }

    /* ── Content area ── */
    .content { flex: 1; padding: 2.5rem; max-width: 760px; }

    .section { display: none; }
    .section.active { display: block; animation: fadeIn 0.2s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    .section-header { margin-bottom: 2rem; }
    .section-kicker { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.4rem; }
    .section-title { font-family: 'Inter Tight', sans-serif; font-weight: 800; font-size: 1.6rem; letter-spacing: -0.02em; color: var(--text); margin-bottom: 0.3rem; }
    .section-sub { font-size: 0.85rem; color: var(--muted); line-height: 1.5; }
    .section-divider { width: 40px; height: 3px; background: linear-gradient(90deg, var(--gold), #ff9500); border-radius: 2px; margin-top: 1rem; }

    /* ── Form fields ── */
    .field-group { display: flex; flex-direction: column; gap: 1.25rem; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .field { display: flex; flex-direction: column; gap: 0.4rem; }
    .field label { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
    .field label .req { color: var(--gold); margin-left: 2px; }
    .field input, .field select, .field textarea {
      background: rgba(10,21,56,0.7);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 0.6rem 0.9rem;
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 0.88rem;
      outline: none;
      transition: border-color 0.15s;
      width: 100%;
    }
    .field input:focus, .field select:focus, .field textarea:focus { border-color: rgba(251,192,45,0.5); }
    .field input[type="color"] { padding: 0.2rem 0.4rem; height: 2.4rem; cursor: pointer; }
    .field select option { background: #0a1538; }
    .field textarea { resize: vertical; min-height: 80px; }
    .field-hint { font-size: 0.75rem; color: #475569; line-height: 1.4; }

    /* ── Radio / Checkbox groups ── */
    .radio-group, .check-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .radio-option, .check-option {
      display: flex; align-items: flex-start; gap: 0.75rem;
      padding: 0.75rem 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      cursor: pointer; transition: border-color 0.15s;
    }
    .radio-option:has(input:checked), .check-option:has(input:checked) { border-color: var(--gold-border); background: var(--gold-dim); }
    .radio-option input[type="radio"], .check-option input[type="checkbox"] { margin-top: 2px; accent-color: var(--gold); flex-shrink: 0; }
    .radio-option-label { display: flex; flex-direction: column; gap: 0.15rem; }
    .radio-option-name { font-size: 0.88rem; font-weight: 600; color: var(--text); }
    .radio-option-desc { font-size: 0.75rem; color: var(--muted); }

    /* ── Dynamic list ── */
    .dyn-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .dyn-item {
      display: flex; align-items: center; gap: 0.5rem;
    }
    .dyn-item input {
      flex: 1;
      background: rgba(10,21,56,0.7); border: 1px solid var(--border); border-radius: 7px;
      padding: 0.55rem 0.85rem; color: var(--text); font-size: 0.85rem; outline: none;
      transition: border-color 0.15s;
    }
    .dyn-item input:focus { border-color: rgba(251,192,45,0.5); }
    .dyn-remove {
      width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(248,250,252,0.08);
      background: transparent; color: #475569; font-size: 1rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      transition: all 0.15s; line-height: 1;
    }
    .dyn-remove:hover { border-color: #f87171; color: #f87171; }
    .dyn-add {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase;
      padding: 0.4rem 0.85rem; border-radius: 5px;
      border: 1px dashed rgba(251,192,45,0.3); background: transparent; color: rgba(251,192,45,0.6);
      cursor: pointer; transition: all 0.15s; margin-top: 0.25rem;
    }
    .dyn-add:hover { border-color: var(--gold); color: var(--gold); background: var(--gold-dim); }

    /* ── Competidores ── */
    .comp-item {
      display: grid; grid-template-columns: 1fr 1fr 140px 28px;
      gap: 0.5rem; align-items: center;
    }
    .comp-item input, .comp-item select {
      background: rgba(10,21,56,0.7); border: 1px solid var(--border); border-radius: 7px;
      padding: 0.55rem 0.85rem; color: var(--text); font-size: 0.85rem; outline: none;
    }
    .comp-item input:focus, .comp-item select:focus { border-color: rgba(251,192,45,0.5); }
    .comp-item select option { background: #0a1538; }

    /* ── Propuesta card ── */
    .prop-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
      padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.6rem; position: relative;
    }
    .prop-card-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem; }
    .prop-num { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.15em; color: var(--gold); }
    .prop-remove {
      position: absolute; top: 0.75rem; right: 0.75rem;
      width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--border);
      background: transparent; color: #475569; font-size: 0.9rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s;
    }
    .prop-remove:hover { border-color: #f87171; color: #f87171; }
    .prop-char-count { font-size: 0.72rem; color: #475569; text-align: right; }
    .prop-char-count.warn { color: #f87171; }

    /* ── Color preview ── */
    .color-preview {
      display: flex; gap: 1rem; align-items: center;
      padding: 1rem 1.25rem; border-radius: 10px; border: 1px solid var(--border);
      background: var(--surface); margin-top: 0.5rem;
    }
    .color-swatch { width: 40px; height: 40px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); }
    .color-preview-text { font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: 1rem; }

    /* ── Nav buttons ── */
    .bottombar {
      padding: 1.25rem 2.5rem;
      border-top: 1px solid var(--border);
      display: flex; gap: 0.75rem; align-items: center;
      background: rgba(5,10,30,0.9); backdrop-filter: blur(8px);
      position: sticky; bottom: 0;
    }
    .btn { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; padding: 0.65rem 1.4rem; border-radius: 7px; border: none; cursor: pointer; transition: all 0.2s; }
    .btn-primary { background: var(--gold); color: #050a1e; font-weight: 600; }
    .btn-primary:hover { background: #ffd54f; }
    .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; }
    .btn-secondary { background: var(--gold-dim); border: 1px solid var(--gold-border); color: var(--gold); }
    .btn-secondary:hover { background: rgba(251,192,45,0.2); }
    .btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--muted); }
    .btn-ghost:hover { border-color: rgba(248,250,252,0.2); color: #94a3b8; }
    .saving-msg { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase; color: #4ade80; margin-left: auto; display: none; }
    .error-msg { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase; color: #f87171; margin-left: auto; display: none; }

    /* ── Validation ── */
    .field-error { font-size: 0.75rem; color: #f87171; margin-top: 0.2rem; display: none; }
    .field input.invalid, .field select.invalid { border-color: #f87171; }

    /* ── Section divider ── */
    .sub-section { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
    .sub-title { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(251,192,45,0.6); margin-bottom: 1rem; }

    /* ── Mixta warning ── */
    .mixta-note { font-size: 0.78rem; color: rgba(251,192,45,0.7); background: rgba(251,192,45,0.06); border: 1px solid rgba(251,192,45,0.15); border-radius: 6px; padding: 0.5rem 0.75rem; display: none; margin-top: 0.5rem; }
    #mixta-combos { display: none; }

    @media (max-width: 768px) {
      .sidebar { display: none; }
      .field-row { grid-template-columns: 1fr; }
      .comp-item { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<div class="layout">

  <!-- ── Sidebar ── -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <a href="/candidates">
        <img src="/goberna-logo.png" alt="Goberna" style="width:28px; height:28px; filter:drop-shadow(0 0 6px rgba(251,192,45,0.4));" />
        <span>Candidatos</span>
      </a>
    </div>
    <nav class="step-list" id="stepList">
      <!-- Rendered by JS -->
    </nav>
    <div style="padding:1rem 1.25rem; border-top:1px solid rgba(248,250,252,0.05);">
      <a href="/candidates" style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:#334155; text-decoration:none; transition:color 0.15s;"
        onmouseenter="this.style.color='#64748b'" onmouseleave="this.style.color='#334155'">
        ← Volver
      </a>
    </div>
  </aside>

  <!-- ── Main ── -->
  <div class="main">

    <!-- Topbar -->
    <div class="topbar">
      <div>
        <div class="topbar-step" id="stepLabel">Paso 1 de 8</div>
        <div class="topbar-title" id="stepTitle">Sesión del consultor</div>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" id="progressFill" style="width:12.5%"></div>
      </div>
      <div class="pct-label" id="pctLabel">12%</div>
      <div class="mode-toggle">
        <button class="mode-btn active" id="modeRapido">Rápido</button>
        <button class="mode-btn" id="modeCompleto" title="Disponible después de guardar">Completo</button>
      </div>
    </div>

    <!-- Content -->
    <div class="content">

      <!-- ══ S1 — Meta ══ -->
      <div class="section active" id="section-0">
        <div class="section-header">
          <div class="section-kicker">01 · Sesión</div>
          <div class="section-title">Consultor y sesión</div>
          <div class="section-sub">Datos de quien realiza el onboarding y fecha de la sesión.</div>
          <div class="section-divider"></div>
        </div>
        <div class="field-group">
          <div class="field-row">
            <div class="field">
              <label>Tu nombre<span class="req">*</span></label>
              <input type="text" id="meta_consultor_nombre" placeholder="Ej: Ana García" />
            </div>
            <div class="field">
              <label>Tu email<span class="req">*</span></label>
              <input type="email" id="meta_consultor_email" placeholder="ana@grupogoberna.com" />
            </div>
          </div>
          <div class="field" style="max-width:220px">
            <label>Fecha de sesión<span class="req">*</span></label>
            <input type="date" id="meta_fecha_sesion" value={today} />
          </div>
        </div>
      </div>

      <!-- ══ S2 — Candidato ══ -->
      <div class="section" id="section-1">
        <div class="section-header">
          <div class="section-kicker">02 · Candidato</div>
          <div class="section-title">Identidad del candidato</div>
          <div class="section-sub">Datos básicos de la persona que postula. Solo nombre y teléfono son obligatorios.</div>
          <div class="section-divider"></div>
        </div>
        <div class="field-group">
          <div class="field">
            <label>Tipo de candidato<span class="req">*</span></label>
            <div class="radio-group">
              {[
                ['candidato-propio', 'Candidato propio', 'Es el candidato que estamos asesorando'],
                ['rival',  'Rival',  'Candidato de la competencia — para análisis'],
                ['aliado', 'Aliado', 'Aliado político o potencial coalición'],
              ].map(([val, name, desc]) => (
                <label class="radio-option">
                  <input type="radio" name="candidato_tipo" value={val} />
                  <span class="radio-option-label">
                    <span class="radio-option-name">{name}</span>
                    <span class="radio-option-desc">{desc}</span>
                  </span>
                </label>
              ))}
            </div>
          </div>
          <div class="field">
            <label>Nombre completo<span class="req">*</span></label>
            <input type="text" id="candidato_nombre_completo" placeholder="Ej: Carlos Alberto Mendoza Ríos" />
          </div>
          <div class="field-row">
            <div class="field">
              <label>Teléfono (E.164)<span class="req">*</span></label>
              <input type="text" id="candidato_telefono" placeholder="+51987654321" />
            </div>
            <div class="field">
              <label>Email (opcional)</label>
              <input type="email" id="candidato_email" placeholder="candidato@ejemplo.pe" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label>Fecha de nacimiento</label>
              <input type="date" id="candidato_nacimiento" />
            </div>
            <div class="field">
              <label>Sexo</label>
              <select id="candidato_sexo">
                <option value="">— Opcional —</option>
                <option value="M">Masculino</option>
                <option value="F">Femenino</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label>Ocupación actual</label>
            <input type="text" id="candidato_ocupacion" placeholder="Ej: Empresario — Constructora XYZ" />
          </div>

          <div class="sub-section">
            <div class="sub-title">Documento de identidad (opcional)</div>
            <div class="field-row">
              <div class="field">
                <label>Tipo</label>
                <select id="candidato_doc_tipo">
                  <option value="DNI">DNI</option>
                  <option value="CE">Carnet de Extranjería</option>
                  <option value="PASAPORTE">Pasaporte</option>
                </select>
              </div>
              <div class="field">
                <label>Número</label>
                <input type="text" id="candidato_doc_num" placeholder="12345678" />
              </div>
            </div>
          </div>

          <div class="sub-section">
            <div class="sub-title">Redes sociales (opcional)</div>
            <div class="field-row">
              <div class="field">
                <label>Facebook</label>
                <input type="text" id="red_facebook" placeholder="facebook.com/..." />
              </div>
              <div class="field">
                <label>Instagram</label>
                <input type="text" id="red_instagram" placeholder="@handle" />
              </div>
            </div>
            <div class="field-row" style="margin-top:0.75rem">
              <div class="field">
                <label>TikTok</label>
                <input type="text" id="red_tiktok" placeholder="@handle" />
              </div>
              <div class="field">
                <label>YouTube</label>
                <input type="text" id="red_youtube" placeholder="youtube.com/..." />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ══ S3 — Postulación ══ -->
      <div class="section" id="section-2">
        <div class="section-header">
          <div class="section-kicker">03 · Postulación</div>
          <div class="section-title">Cargo y territorio</div>
          <div class="section-sub">A qué postula, dónde, y cuándo es la elección.</div>
          <div class="section-divider"></div>
        </div>
        <div class="field-group">
          <div class="field-row">
            <div class="field">
              <label>Cargo<span class="req">*</span></label>
              <select id="post_cargo">
                <option value="">— Seleccionar —</option>
                <option value="alcalde_distrital">Alcalde Distrital</option>
                <option value="alcalde_provincial">Alcalde Provincial</option>
                <option value="regidor">Regidor</option>
                <option value="consejero_regional">Consejero Regional</option>
                <option value="gobernador_regional">Gobernador Regional</option>
                <option value="congresista">Congresista</option>
                <option value="presidente">Presidente</option>
              </select>
            </div>
            <div class="field">
              <label>Organización política<span class="req">*</span></label>
              <input type="text" id="post_partido" placeholder="Ej: Alianza para el Progreso" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label>Territorio / Circunscripción<span class="req">*</span></label>
              <input type="text" id="post_territorio" placeholder="Ej: Lima Norte" />
            </div>
            <div class="field">
              <label>Nivel territorial<span class="req">*</span></label>
              <select id="post_nivel">
                <option value="distrital">Distrital</option>
                <option value="provincial">Provincial</option>
                <option value="regional">Regional</option>
                <option value="nacional">Nacional</option>
              </select>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label>Fecha de elección<span class="req">*</span></label>
              <input type="date" id="post_fecha" />
            </div>
            <div class="field">
              <label>Número de lista</label>
              <input type="number" id="post_num_lista" min="1" max="999" placeholder="Ej: 7" />
            </div>
          </div>
        </div>
      </div>

      <!-- ══ S4 — Estrategia ══ -->
      <div class="section" id="section-3">
        <div class="section-header">
          <div class="section-kicker">04 · Estrategia</div>
          <div class="section-title">Marco estratégico</div>
          <div class="section-sub">Tipo de campaña, eje emocional y frentes de batalla.</div>
          <div class="section-divider"></div>
        </div>
        <div class="field-group">
          <div class="field">
            <label>Tipo de elección<span class="req">*</span></label>
            <div class="radio-group" style="flex-direction:row; flex-wrap:wrap; gap:0.5rem;">
              {[
                ['GOBIERNO_LOCAL', 'Gobierno Local'],
                ['PARLAMENTARIA', 'Parlamentaria'],
                ['PRESIDENCIAL', 'Presidencial'],
              ].map(([val, name]) => (
                <label class="radio-option" style="flex:1; min-width:140px;">
                  <input type="radio" name="est_tipo_eleccion" value={val} />
                  <span class="radio-option-name">{name}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="field">
            <label>Tipo de campaña<span class="req">*</span></label>
            <div class="radio-group">
              {[
                ['RACIONAL',   'Racional',   'Data, plan de gobierno, propuestas concretas'],
                ['EMOTIVA',    'Emotiva',    'Conexión humana, historia personal, empatía'],
                ['INSTINTIVA', 'Instintiva', 'Imagen, carisma, presencia física y mediática'],
                ['MIXTA',      'Mixta',      'Combinación de dos tipos — más efectiva en territorios fragmentados'],
              ].map(([val, name, desc]) => (
                <label class="radio-option">
                  <input type="radio" name="est_tipo_campana" value={val} id={`campana_${val}`} />
                  <span class="radio-option-label">
                    <span class="radio-option-name">{name}</span>
                    <span class="radio-option-desc">{desc}</span>
                  </span>
                </label>
              ))}
            </div>
            <div class="mixta-note" id="mixtaNote">Para campaña MIXTA seleccioná exactamente 2 combinaciones abajo.</div>
          </div>

          <div id="mixta-combos">
            <div class="field">
              <label>Combinación mixta (seleccioná 2)<span class="req">*</span></label>
              <div class="check-group" style="flex-direction:row; flex-wrap:wrap; gap:0.5rem;">
                {['RACIONAL', 'EMOTIVA', 'INSTINTIVA'].map(val => (
                  <label class="check-option" style="flex:1; min-width:120px;">
                    <input type="checkbox" name="combinacion_mixta" value={val} />
                    <span class="radio-option-name">{val.charAt(0) + val.slice(1).toLowerCase()}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <div class="field">
            <label>Eje emocional<span class="req">*</span></label>
            <select id="est_eje">
              <option value="">— Seleccionar —</option>
              <option value="PLAN_DE_GOBIERNO">Plan de gobierno</option>
              <option value="EQUIPO_DE_CAMPAÑA">Equipo de campaña</option>
              <option value="SIMPATIA">Simpatía</option>
              <option value="ESPERANZA">Esperanza</option>
              <option value="ODIO">Indignación / Odio</option>
              <option value="MIEDO">Miedo</option>
            </select>
          </div>

          <div class="field">
            <label>Frente principal<span class="req">*</span></label>
            <div class="radio-group" style="flex-direction:row; flex-wrap:wrap; gap:0.5rem;">
              {[
                ['TIERRA', '🏘️ Tierra', 'Puerta a puerta, mercados, mítines'],
                ['MAR',    '📺 Mar',    'TV, radio, prensa escrita'],
                ['AIRE',   '📱 Aire',   'Redes sociales, ads digitales'],
              ].map(([val, name, desc]) => (
                <label class="radio-option" style="flex:1; min-width:140px;">
                  <input type="radio" name="est_frente_principal" value={val} />
                  <span class="radio-option-label">
                    <span class="radio-option-name">{name}</span>
                    <span class="radio-option-desc">{desc}</span>
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div class="field">
            <label>Frentes secundarios (opcional)</label>
            <div class="check-group" style="flex-direction:row; flex-wrap:wrap; gap:0.5rem;" id="frentes-sec">
              {[
                ['TIERRA', '🏘️ Tierra'],
                ['MAR',    '📺 Mar'],
                ['AIRE',   '📱 Aire'],
              ].map(([val, name]) => (
                <label class="check-option" style="flex:1; min-width:120px;">
                  <input type="checkbox" name="frente_secundario" value={val} />
                  <span class="radio-option-name">{name}</span>
                </label>
              ))}
            </div>
            <div class="field-hint" style="margin-top:0.4rem;">El frente principal se excluye automáticamente.</div>
          </div>
        </div>
      </div>

      <!-- ══ S5 — Diagnóstico ══ -->
      <div class="section" id="section-4">
        <div class="section-header">
          <div class="section-kicker">05 · Diagnóstico</div>
          <div class="section-title">FODA + Competidores</div>
          <div class="section-sub">Mínimo 3 items por cuadrante. Máximo 5 competidores.</div>
          <div class="section-divider"></div>
        </div>
        <div class="field-group">
          <div>
            <div class="sub-title" style="color:#4ade80;">Fortalezas (mín. 3)</div>
            <div class="dyn-list" id="list-fortalezas"></div>
            <button class="dyn-add" onclick="addItem('fortalezas')">+ Agregar fortaleza</button>
          </div>
          <div>
            <div class="sub-title" style="color:#f87171; margin-top:1rem;">Debilidades (mín. 3)</div>
            <div class="dyn-list" id="list-debilidades"></div>
            <button class="dyn-add" onclick="addItem('debilidades')">+ Agregar debilidad</button>
          </div>
          <div class="sub-section">
            <div class="sub-title" style="color:#60a5fa;">Oportunidades (mín. 3)</div>
            <div class="dyn-list" id="list-oportunidades"></div>
            <button class="dyn-add" onclick="addItem('oportunidades')">+ Agregar oportunidad</button>
          </div>
          <div>
            <div class="sub-title" style="color:#fb923c; margin-top:1rem;">Amenazas (mín. 3)</div>
            <div class="dyn-list" id="list-amenazas"></div>
            <button class="dyn-add" onclick="addItem('amenazas')">+ Agregar amenaza</button>
          </div>
          <div class="sub-section">
            <div class="sub-title">Competidores principales (mín. 1, máx. 5)</div>
            <div style="display:grid; grid-template-columns:1fr 1fr 140px 28px; gap:0.5rem; margin-bottom:0.5rem;">
              <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; color:#334155;">Nombre</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; color:#334155;">Partido</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; color:#334155;">Amenaza</span>
              <span></span>
            </div>
            <div class="dyn-list" id="list-competidores"></div>
            <button class="dyn-add" onclick="addCompetidor()">+ Agregar competidor</button>
          </div>
        </div>
      </div>

      <!-- ══ S6 — Propuestas ══ -->
      <div class="section" id="section-5">
        <div class="section-header">
          <div class="section-kicker">06 · Propuestas</div>
          <div class="section-title">Ejes programáticos</div>
          <div class="section-sub">Entre 3 y 6 propuestas. Descripción corta máximo 140 caracteres.</div>
          <div class="section-divider"></div>
        </div>
        <div id="prop-list" style="display:flex; flex-direction:column; gap:0.75rem;"></div>
        <button class="dyn-add" id="prop-add" onclick="addPropuesta()" style="margin-top:0.75rem;">+ Agregar propuesta</button>
      </div>

      <!-- ══ S7 — Branding ══ -->
      <div class="section" id="section-6">
        <div class="section-header">
          <div class="section-kicker">07 · Branding</div>
          <div class="section-title">Identidad visual y slogan</div>
          <div class="section-sub">Slogan y color primario son obligatorios. Definen el look de la presentación.</div>
          <div class="section-divider"></div>
        </div>
        <div class="field-group">
          <div class="field">
            <label>Slogan de campaña<span class="req">*</span></label>
            <input type="text" id="brand_slogan" placeholder="Ej: Lima Norte que cumple" />
          </div>
          <div class="field-row">
            <div class="field">
              <label>Color primario<span class="req">*</span></label>
              <input type="color" id="brand_color_primario" value="#fbc02d" />
            </div>
            <div class="field">
              <label>Color secundario</label>
              <input type="color" id="brand_color_secundario" value="#0a1538" />
            </div>
          </div>
          <!-- Live preview -->
          <div class="color-preview" id="colorPreview">
            <div class="color-swatch" id="swatchPrimario" style="background:#fbc02d;"></div>
            <div class="color-swatch" id="swatchSecundario" style="background:#0a1538;"></div>
            <div>
              <div class="color-preview-text" id="previewSlogan" style="color:#fbc02d;">Slogan aquí</div>
              <div style="font-size:0.72rem; color:#475569; margin-top:0.2rem;">Vista previa de identidad</div>
            </div>
          </div>
          <div class="field">
            <label>URL de logo (opcional)</label>
            <input type="text" id="brand_logo" placeholder="https://..." />
            <div class="field-hint">URL pública de la imagen. Se mostrará en la presentación.</div>
          </div>
        </div>
      </div>

      <!-- ══ S8 — Contexto territorio ══ -->
      <div class="section" id="section-7">
        <div class="section-header">
          <div class="section-kicker">08 · Territorio</div>
          <div class="section-title">Contexto del territorio</div>
          <div class="section-sub">Datos clave del territorio para el slide de contexto.</div>
          <div class="section-divider"></div>
        </div>
        <div class="field-group">
          <div class="field" style="max-width:260px;">
            <label>Población aproximada</label>
            <input type="number" id="terr_poblacion" placeholder="Ej: 1200000" min="0" />
          </div>
          <div>
            <div class="sub-title">Principales problemas del territorio</div>
            <div class="dyn-list" id="list-problemas"></div>
            <button class="dyn-add" onclick="addItem('problemas')">+ Agregar problema</button>
          </div>
          <div class="sub-section">
            <div class="sub-title" style="color:#4ade80;">Zonas fuertes (donde el candidato tiene apoyo)</div>
            <div class="dyn-list" id="list-zonas-fuertes"></div>
            <button class="dyn-add" onclick="addItem('zonas-fuertes')">+ Agregar zona</button>
          </div>
          <div>
            <div class="sub-title" style="color:#f87171; margin-top:1rem;">Zonas a trabajar (débiles)</div>
            <div class="dyn-list" id="list-zonas-debiles"></div>
            <button class="dyn-add" onclick="addItem('zonas-debiles')">+ Agregar zona</button>
          </div>
        </div>
      </div>

    </div><!-- /content -->

    <!-- Bottom nav -->
    <div class="bottombar">
      <button class="btn btn-ghost" id="btnPrev" onclick="prevStep()">← Anterior</button>
      <button class="btn btn-secondary" id="btnNext" onclick="nextStep()">Siguiente →</button>
      <button class="btn btn-primary" id="btnSave" style="display:none;" onclick="saveCandidate()">
        Guardar y generar presentación ✓
      </button>
      <span class="saving-msg" id="savingMsg">Guardando...</span>
      <span class="error-msg" id="errorMsg"></span>
    </div>

  </div><!-- /main -->
</div><!-- /layout -->

<script>
// ─── State ──────────────────────────────────────────────────────────────────
const STEPS = [
  { id: 0, label: 'Sesión',      title: 'Consultor y sesión' },
  { id: 1, label: 'Candidato',   title: 'Identidad del candidato' },
  { id: 2, label: 'Postulación', title: 'Cargo y territorio' },
  { id: 3, label: 'Estrategia',  title: 'Marco estratégico' },
  { id: 4, label: 'Diagnóstico', title: 'FODA + Competidores' },
  { id: 5, label: 'Propuestas',  title: 'Ejes programáticos' },
  { id: 6, label: 'Branding',    title: 'Identidad visual' },
  { id: 7, label: 'Territorio',  title: 'Contexto del territorio' },
];

let currentStep = 0;
const visited = new Set([0]);

// Dynamic list state
const lists = {
  fortalezas:    ['', '', ''],
  debilidades:   ['', '', ''],
  oportunidades: ['', '', ''],
  amenazas:      ['', '', ''],
  problemas:     [''],
  'zonas-fuertes': [],
  'zonas-debiles': [],
};
let competidores = [{ nombre: '', partido: '', nivel_amenaza: 'alto' }];
let propuestas = [
  { titulo: '', descripcion_corta: '', icono: '→' },
  { titulo: '', descripcion_corta: '', icono: '→' },
  { titulo: '', descripcion_corta: '', icono: '→' },
];

// ─── Render sidebar ──────────────────────────────────────────────────────────
function renderSidebar() {
  const nav = document.getElementById('stepList');
  nav.innerHTML = STEPS.map(s => `
    <div class="step-item ${s.id === currentStep ? 'active' : ''} ${visited.has(s.id) && s.id !== currentStep ? 'done' : ''}"
      onclick="goToStep(${s.id})">
      <div class="step-dot"></div>
      <span class="step-label">${String(s.id + 1).padStart(2,'0')} ${s.label}</span>
    </div>
  `).join('');
}

// ─── Step navigation ─────────────────────────────────────────────────────────
function showStep(n) {
  document.querySelectorAll('.section').forEach((el, i) => {
    el.classList.toggle('active', i === n);
  });
  document.getElementById('stepLabel').textContent = `Paso ${n + 1} de ${STEPS.length}`;
  document.getElementById('stepTitle').textContent = STEPS[n].title;
  const pct = Math.round((n + 1) / STEPS.length * 100);
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('pctLabel').textContent = pct + '%';
  document.getElementById('btnPrev').style.display = n === 0 ? 'none' : '';
  const isLast = n === STEPS.length - 1;
  document.getElementById('btnNext').style.display = isLast ? 'none' : '';
  document.getElementById('btnSave').style.display = isLast ? '' : 'none';
  renderSidebar();
}

function goToStep(n) {
  currentStep = n;
  visited.add(n);
  showStep(n);
}

function nextStep() {
  if (currentStep < STEPS.length - 1) {
    goToStep(currentStep + 1);
  }
}
function prevStep() {
  if (currentStep > 0) {
    goToStep(currentStep - 1);
  }
}

// ─── Dynamic lists ───────────────────────────────────────────────────────────
function renderList(key) {
  const el = document.getElementById('list-' + key);
  if (!el) return;
  el.innerHTML = lists[key].map((val, i) => `
    <div class="dyn-item">
      <input type="text" value="${escHtml(val)}" placeholder="Escribí aquí..."
        oninput="lists['${key}'][${i}] = this.value" />
      <button class="dyn-remove" onclick="removeItem('${key}',${i})" title="Eliminar">×</button>
    </div>
  `).join('');
}

function addItem(key) {
  lists[key].push('');
  renderList(key);
  // Focus last input
  const el = document.getElementById('list-' + key);
  const inputs = el.querySelectorAll('input');
  inputs[inputs.length - 1]?.focus();
}

function removeItem(key, idx) {
  if (lists[key].length <= 1) return;
  lists[key].splice(idx, 1);
  renderList(key);
}

// ─── Competidores ─────────────────────────────────────────────────────────────
function renderCompetidores() {
  const el = document.getElementById('list-competidores');
  el.innerHTML = competidores.map((c, i) => `
    <div class="comp-item">
      <input type="text" value="${escHtml(c.nombre)}" placeholder="Nombre del candidato"
        oninput="competidores[${i}].nombre = this.value" />
      <input type="text" value="${escHtml(c.partido)}" placeholder="Partido / movimiento"
        oninput="competidores[${i}].partido = this.value" />
      <select oninput="competidores[${i}].nivel_amenaza = this.value">
        ${['alto','medio','bajo'].map(v => `<option value="${v}" ${c.nivel_amenaza===v?'selected':''}>${v.charAt(0).toUpperCase()+v.slice(1)}</option>`).join('')}
      </select>
      <button class="dyn-remove" onclick="removeCompetidor(${i})" title="Eliminar">×</button>
    </div>
  `).join('');
}

function addCompetidor() {
  if (competidores.length >= 5) return;
  competidores.push({ nombre: '', partido: '', nivel_amenaza: 'alto' });
  renderCompetidores();
}
function removeCompetidor(i) {
  if (competidores.length <= 1) return;
  competidores.splice(i, 1);
  renderCompetidores();
}

// ─── Propuestas ──────────────────────────────────────────────────────────────
function renderPropuestas() {
  const el = document.getElementById('prop-list');
  el.innerHTML = propuestas.map((p, i) => `
    <div class="prop-card">
      <div class="prop-card-header">
        <span class="prop-num">PROPUESTA ${String(i+1).padStart(2,'0')}</span>
        <input type="text" value="${escHtml(p.icono)}" placeholder="→" style="width:40px; text-align:center;"
          oninput="propuestas[${i}].icono = this.value" />
      </div>
      <button class="prop-remove" onclick="removePropuesta(${i})">×</button>
      <div class="field">
        <label>Título<span class="req">*</span></label>
        <input type="text" value="${escHtml(p.titulo)}" placeholder="Ej: Seguridad ciudadana integrada"
          oninput="propuestas[${i}].titulo = this.value" />
      </div>
      <div class="field">
        <label>Descripción corta<span class="req">*</span></label>
        <input type="text" value="${escHtml(p.descripcion_corta)}" maxlength="140"
          placeholder="Máx. 140 caracteres"
          oninput="propuestas[${i}].descripcion_corta = this.value; updateCharCount(${i}, this.value.length)" />
        <div class="prop-char-count" id="char-${i}">${p.descripcion_corta.length}/140</div>
      </div>
    </div>
  `).join('');
  document.getElementById('prop-add').style.display = propuestas.length >= 6 ? 'none' : '';
}

function updateCharCount(i, n) {
  const el = document.getElementById('char-' + i);
  if (!el) return;
  el.textContent = n + '/140';
  el.classList.toggle('warn', n >= 130);
}

function addPropuesta() {
  if (propuestas.length >= 6) return;
  propuestas.push({ titulo: '', descripcion_corta: '', icono: '→' });
  renderPropuestas();
}
function removePropuesta(i) {
  if (propuestas.length <= 1) return;
  propuestas.splice(i, 1);
  renderPropuestas();
}

// ─── Branding preview ────────────────────────────────────────────────────────
function updateBrandPreview() {
  const c1 = document.getElementById('brand_color_primario').value;
  const c2 = document.getElementById('brand_color_secundario').value;
  const sl = document.getElementById('brand_slogan').value || 'Slogan aquí';
  document.getElementById('swatchPrimario').style.background = c1;
  document.getElementById('swatchSecundario').style.background = c2;
  document.getElementById('previewSlogan').style.color = c1;
  document.getElementById('previewSlogan').textContent = sl;
}

// ─── Mixta toggle ────────────────────────────────────────────────────────────
function setupMixta() {
  document.querySelectorAll('[name="est_tipo_campana"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const isMixta = document.querySelector('[name="est_tipo_campana"]:checked')?.value === 'MIXTA';
      document.getElementById('mixta-combos').style.display = isMixta ? 'block' : 'none';
      document.getElementById('mixtaNote').style.display = isMixta ? 'block' : 'none';
    });
  });
}

// ─── Collect form data ────────────────────────────────────────────────────────
function collectData() {
  const val = id => document.getElementById(id)?.value?.trim() ?? '';
  const radioVal = name => document.querySelector(`[name="${name}"]:checked`)?.value ?? '';
  const checkVals = name => [...document.querySelectorAll(`[name="${name}"]:checked`)].map(el => el.value);
  const listVals = key => lists[key].filter(s => s.trim());

  const tipoCampana = radioVal('est_tipo_campana');
  const frentePrincipal = radioVal('est_frente_principal');
  const frentesSecundarios = checkVals('frente_secundario').filter(f => f !== frentePrincipal);

  return {
    meta: {
      consultor_nombre: val('meta_consultor_nombre'),
      consultor_email:  val('meta_consultor_email'),
      fecha_sesion:     val('meta_fecha_sesion'),
    },
    candidato: {
      tipo:              radioVal('candidato_tipo') || 'candidato-propio',
      nombre_completo:   val('candidato_nombre_completo'),
      foto_url:          null,
      documento_tipo:    val('candidato_doc_tipo') || 'DNI',
      documento_numero:  val('candidato_doc_num') || null,
      fecha_nacimiento:  val('candidato_nacimiento') || null,
      sexo:              val('candidato_sexo') || null,
      telefono_e164:     val('candidato_telefono'),
      email:             val('candidato_email') || null,
      ocupacion_actual:  val('candidato_ocupacion') || null,
      redes_sociales: {
        facebook:  val('red_facebook') || null,
        instagram: val('red_instagram') || null,
        tiktok:    val('red_tiktok') || null,
        youtube:   val('red_youtube') || null,
      },
    },
    postulacion: {
      cargo_codigo:           val('post_cargo'),
      organizacion_politica:  val('post_partido'),
      numero_lista:           val('post_num_lista') ? Number(val('post_num_lista')) : null,
      fecha_eleccion:         val('post_fecha'),
      id_departamento:        null,
      id_provincia:           null,
      id_distrito:            null,
      nombre_territorio:      val('post_territorio'),
      nivel_territorio:       val('post_nivel'),
    },
    estrategia: {
      tipo_eleccion:       radioVal('est_tipo_eleccion'),
      tipo_campana:        tipoCampana,
      combinacion_mixta:   tipoCampana === 'MIXTA' ? checkVals('combinacion_mixta') : [],
      eje_emocional:       val('est_eje'),
      frente_principal:    frentePrincipal,
      frentes_secundarios: frentesSecundarios,
    },
    diagnostico_inicial: {
      fortalezas:            listVals('fortalezas'),
      debilidades:           listVals('debilidades'),
      oportunidades:         listVals('oportunidades'),
      amenazas:              listVals('amenazas'),
      principales_competidores: competidores.filter(c => c.nombre.trim()),
    },
    propuestas: propuestas
      .filter(p => p.titulo.trim())
      .map((p, i) => ({ orden: i + 1, ...p })),
    branding: {
      slogan:           val('brand_slogan'),
      color_primario:   val('brand_color_primario') || '#fbc02d',
      color_secundario: val('brand_color_secundario') || null,
      logo_url:         val('brand_logo') || null,
      foto_perfil_url:  null,
    },
    contexto_territorio: {
      poblacion_aproximada: val('terr_poblacion') ? Number(val('terr_poblacion')) : null,
      principales_problemas: listVals('problemas'),
      zonas_fuertes:         listVals('zonas-fuertes'),
      zonas_debiles:         listVals('zonas-debiles'),
    },
  };
}

// ─── Save ────────────────────────────────────────────────────────────────────
async function saveCandidate() {
  const data = collectData();

  // Basic validation
  if (!data.meta.consultor_nombre) { goToStep(0); alert('Faltó el nombre del consultor'); return; }
  if (!data.candidato.nombre_completo) { goToStep(1); alert('Faltó el nombre del candidato'); return; }
  if (!data.postulacion.cargo_codigo) { goToStep(2); alert('Faltó seleccionar el cargo'); return; }
  if (!data.postulacion.nombre_territorio) { goToStep(2); alert('Faltó el territorio'); return; }
  if (!data.postulacion.fecha_eleccion) { goToStep(2); alert('Faltó la fecha de elección'); return; }
  if (data.propuestas.length < 3) { goToStep(5); alert('Necesitás al menos 3 propuestas'); return; }
  if (!data.branding.slogan) { goToStep(6); alert('Faltó el slogan'); return; }

  const saveBtn = document.getElementById('btnSave');
  const savingMsg = document.getElementById('savingMsg');
  const errorMsg = document.getElementById('errorMsg');
  saveBtn.disabled = true;
  savingMsg.style.display = '';
  errorMsg.style.display = 'none';

  try {
    const res = await fetch('/api/candidates', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    const result = await res.json();
    if (result.ok) {
      window.location.href = '/candidates/' + result.slug;
    } else {
      throw new Error(result.error ?? 'Error desconocido');
    }
  } catch (err) {
    saveBtn.disabled = false;
    savingMsg.style.display = 'none';
    errorMsg.textContent = 'Error: ' + err.message;
    errorMsg.style.display = '';
  }
}

// ─── Utils ───────────────────────────────────────────────────────────────────
function escHtml(str) {
  return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ─── Init ────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  // Render all dynamic lists
  Object.keys(lists).forEach(renderList);
  renderCompetidores();
  renderPropuestas();
  renderSidebar();
  showStep(0);
  setupMixta();

  // Branding live preview
  ['brand_color_primario','brand_color_secundario','brand_slogan'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', updateBrandPreview);
  });
  updateBrandPreview();

  // Mode toggle (completo = placeholder only)
  document.getElementById('modeCompleto').addEventListener('click', () => {
    alert('El modo completo (5N + ECD) se realiza con Claude una vez guardado el modo rápido.');
  });
});
</script>
