---
import PresentationLayout from '../../layouts/PresentationLayout.astro';
import SlideRenderer from '../../components/SlideRenderer.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const projectsDir = path.join(process.cwd(), 'projects');
  if (!fs.existsSync(projectsDir)) return [];
  return fs.readdirSync(projectsDir, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => ({ params: { project: d.name } }));
}

const { project } = Astro.params;
const pFile = path.join(process.cwd(), 'projects', project, 'presentation.json');

if (!fs.existsSync(pFile)) {
  return Astro.redirect('/');
}

const presentation = JSON.parse(fs.readFileSync(pFile, 'utf-8'));
---

<PresentationLayout meta={presentation.meta} slideCount={presentation.slides.length}>
  {presentation.slides.map((slide: any, index: number) => (
    <SlideRenderer slide={slide} index={index} />
  ))}
</PresentationLayout>
