---
import AppShell from '../../../layouts/AppShell.astro';
import { readMeta, readChat, listResearchFiles, listOutputs, WORKSPACE_TYPES } from '../../../lib/workspaces.mjs';

export const prerender = false;

const id = Astro.params.id as string;
const meta = readMeta(id);

if (!meta) {
  return Astro.redirect('/');
}

const chat = readChat(id);
const files = listResearchFiles(id);
const outputs = listOutputs(id);

const TYPE_COLOR: Record<string, string> = {
  presentation: '#60a5fa', candidate: '#fbc02d', vetting: '#f87171',
  diagnostic: '#4ade80', general: '#94a3b8',
};
const color = TYPE_COLOR[meta.type] ?? '#94a3b8';
const typeLabel = (WORKSPACE_TYPES as any)[meta.type] ?? meta.type;

// Detect which previews are available
const hasPresentation = outputs.some(o => o.name === 'presentation.json');
const hasTerritorial  = outputs.some(o => o.name === 'territorial.json');
const hasProfile      = outputs.some(o => o.name === 'profile.json' || o.name === 'vetting-report.json');

function fmtSize(b: number): string {
  if (b < 1024) return b + ' B';
  if (b < 1024*1024) return (b/1024).toFixed(1) + ' KB';
  return (b/1024/1024).toFixed(1) + ' MB';
}

const EXT_ICON: Record<string,string> = {
  pdf: '📄', docx: '📝', doc: '📝', xlsx: '📊', xls: '📊', csv: '📊',
  png: '🖼', jpg: '🖼', jpeg: '🖼', webp: '🖼', gif: '🖼',
  json: '⟨/⟩', md: '📑', txt: '📑',
};
---

<AppShell title={`${meta.title} — Goberna`} narrow={false}>
  <div class="ws-layout">

    <!-- ─── LEFT: archivos ────────────────────────────────────────── -->
    <aside class="pane pane-left" id="filesPane">
      <header class="pane-header">
        <a href="/" class="back-link">← Workspaces</a>
        <h2 class="ws-title">{meta.title}</h2>
        <div class="ws-meta">
          <span class="badge" style={`background:${color}1a; color:${color};`}>{typeLabel}</span>
        </div>
      </header>

      <div class="files-section">
        <p class="section-label">Archivos · research</p>

        <div id="dropzone" class="dropzone">
          <p class="dz-text">Arrastra archivos aquí</p>
          <p class="dz-sub">o</p>
          <label for="fileInput" class="dz-btn">Selecciona</label>
          <input id="fileInput" type="file" multiple style="display:none;" />
          <p class="dz-hint">PDF · DOCX · XLSX · imágenes · ≤ 25MB c/u</p>
        </div>

        <ul id="fileList" class="file-list">
          {files.map(f => (
            <li class="file-item" data-name={f.name}>
              <span class="file-ico">{EXT_ICON[f.ext] ?? '📎'}</span>
              <div class="file-info">
                <span class="file-name">{f.name}</span>
                <span class="file-size">{fmtSize(f.size)}</span>
              </div>
              <button class="file-del" data-name={f.name} title="Borrar">×</button>
            </li>
          ))}
        </ul>

        {outputs.length > 0 && (
          <>
            <p class="section-label" style="margin-top:1.5rem;">Outputs generados</p>
            <ul class="file-list">
              {outputs.map(o => (
                <li class="file-item">
                  <span class="file-ico">📦</span>
                  <div class="file-info">
                    <span class="file-name">{o.name}</span>
                    <span class="file-size">generado</span>
                  </div>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </aside>

    <!-- ─── CENTER: chat ─────────────────────────────────────────── -->
    <section class="pane pane-center">
      <header class="pane-header chat-header">
        <div class="chat-title-row">
          <span class="chat-dot"></span>
          <span class="chat-label">Conversación</span>
          <span class="chat-stub-tag">stub — Claude real pendiente</span>
        </div>
        <button id="clearChat" class="chat-clear" title="Limpiar">⌫</button>
      </header>

      <div id="chatLog" class="chat-log">
        {chat.length === 0 && (
          <div class="chat-empty">
            <p class="empty-line">Hola. Este workspace está vacío.</p>
            <p class="empty-line dim">Sube archivos a la izquierda y pregúntame qué hacer.</p>
            <div class="empty-suggestions">
              <button class="suggestion" data-prompt="¿Qué archivos tengo?">¿Qué archivos tengo?</button>
              <button class="suggestion" data-prompt="Quiero crear una presentación">Crear presentación</button>
              <button class="suggestion" data-prompt="Quiero hacer un perfil 5N">Perfil 5N</button>
              <button class="suggestion" data-prompt="Hacer diagnóstico territorial">Diagnóstico territorial</button>
            </div>
          </div>
        )}
        {chat.map(m => (
          <div class={`msg msg-${m.role}`}>
            {m.role === 'assistant' && m.stub && <span class="stub-tag">stub</span>}
            <p>{m.content}</p>
          </div>
        ))}
      </div>

      <form id="chatForm" class="chat-form">
        <textarea id="chatInput" rows="2" placeholder="Escribí a Claude…" autocomplete="off"></textarea>
        <button type="submit" id="chatSend" disabled>↑</button>
      </form>
    </section>

    <!-- ─── RIGHT: preview ────────────────────────────────────────── -->
    <aside class="pane pane-right" id="previewPane">
      <header class="pane-header preview-header">
        <div class="preview-tabs" role="tablist">
          {hasPresentation && <button class="tab active" data-tab="presentation">Presentación</button>}
          {hasProfile && <button class="tab" data-tab="profile">Perfil 5N</button>}
          {hasTerritorial && <button class="tab" data-tab="territorial">Diagnóstico</button>}
          {outputs.length === 0 && <span class="preview-empty-tag">Sin outputs aún</span>}
        </div>
      </header>

      <div class="preview-body">
        {outputs.length === 0 ? (
          <div class="preview-empty">
            <p class="empty-line dim">No hay nada que mostrar aún.</p>
            <p class="empty-line dim">Sube archivos o pídele a Claude que genere una presentación.</p>
          </div>
        ) : (
          <>
            {hasPresentation && (
              <iframe id="frame-presentation" class="preview-iframe active"
                src={`/w/${id}/presentation`} loading="lazy"></iframe>
            )}
            {hasProfile && (
              <iframe id="frame-profile" class="preview-iframe"
                src={`/w/${id}/profile`} loading="lazy"></iframe>
            )}
            {hasTerritorial && (
              <iframe id="frame-territorial" class="preview-iframe"
                src={`/w/${id}/territorial`} loading="lazy"></iframe>
            )}
          </>
        )}
      </div>
    </aside>

  </div>

  <style is:global>
    .ws-layout {
      display: grid;
      grid-template-columns: 280px 1fr 540px;
      height: calc(100vh - 52px);
      gap: 0;
      background: var(--bg);
    }
    .pane {
      display: flex; flex-direction: column;
      min-height: 0; overflow: hidden;
      background: var(--bg);
    }
    .pane-left   { border-right: 1px solid var(--border); }
    .pane-center { background: rgba(5, 10, 30, 0.4); }
    .pane-right  { border-left: 1px solid var(--border); }

    .pane-header {
      flex: 0 0 auto; padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border);
      background: rgba(5, 10, 30, 0.6);
    }

    /* Left pane */
    .back-link {
      display: block; font-family: 'JetBrains Mono', monospace;
      font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--text-dim); margin-bottom: 0.4rem;
      transition: color 0.15s;
    }
    .back-link:hover { color: var(--gold); }
    .ws-title { font-family: 'Inter Tight', sans-serif; font-weight: 800; font-size: 1rem; line-height: 1.2; margin-bottom: 0.4rem; }
    .ws-meta { display: flex; gap: 0.35rem; }
    .badge {
      font-family: 'JetBrains Mono', monospace; font-size: 8.5px;
      letter-spacing: 0.15em; text-transform: uppercase;
      padding: 0.15rem 0.45rem; border-radius: 3px;
    }

    .files-section { flex: 1; overflow-y: auto; padding: 1rem; }
    .section-label {
      font-family: 'JetBrains Mono', monospace; font-size: 9px;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--text-faint); margin-bottom: 0.6rem;
    }

    .dropzone {
      border: 1.5px dashed rgba(251,192,45,0.2);
      border-radius: 10px; padding: 1.25rem 1rem;
      text-align: center; transition: all 0.15s;
      margin-bottom: 1rem;
    }
    .dropzone.over {
      border-color: var(--gold);
      background: rgba(251,192,45,0.06);
    }
    .dz-text { font-size: 0.85rem; color: var(--text-muted); }
    .dz-sub { font-size: 0.72rem; color: var(--text-faint); margin: 0.4rem 0; }
    .dz-btn {
      display: inline-block; padding: 0.35rem 0.85rem;
      background: rgba(251,192,45,0.12); border: 1px solid rgba(251,192,45,0.3);
      border-radius: 5px; color: var(--gold); font-size: 0.78rem;
      cursor: pointer; transition: all 0.15s;
    }
    .dz-btn:hover { background: rgba(251,192,45,0.2); }
    .dz-hint { font-size: 0.65rem; color: var(--text-faint); margin-top: 0.6rem; }

    .file-list { list-style: none; display: flex; flex-direction: column; gap: 0.3rem; }
    .file-item {
      display: flex; align-items: center; gap: 0.55rem;
      padding: 0.5rem 0.6rem; border-radius: 6px;
      background: rgba(10, 21, 56, 0.4);
      border: 1px solid var(--border);
      transition: border-color 0.15s, background 0.15s;
    }
    .file-item:hover { border-color: rgba(251,192,45,0.2); }
    .file-ico { font-size: 1rem; flex-shrink: 0; }
    .file-info { flex: 1; min-width: 0; }
    .file-name {
      display: block; font-size: 0.78rem; color: var(--text);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .file-size {
      display: block; font-family: 'JetBrains Mono', monospace;
      font-size: 9px; color: var(--text-faint);
    }
    .file-del {
      background: none; border: none; color: var(--text-faint);
      font-size: 1.1rem; padding: 0 0.3rem; cursor: pointer;
      transition: color 0.15s; flex-shrink: 0;
    }
    .file-del:hover { color: var(--red); }

    /* Center: chat */
    .chat-header { display: flex; align-items: center; justify-content: space-between; }
    .chat-title-row { display: flex; align-items: center; gap: 0.5rem; }
    .chat-dot {
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--green); box-shadow: 0 0 6px rgba(74,222,128,0.5);
    }
    .chat-label {
      font-family: 'JetBrains Mono', monospace; font-size: 10px;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted);
    }
    .chat-stub-tag {
      font-family: 'JetBrains Mono', monospace; font-size: 8.5px;
      letter-spacing: 0.12em; padding: 0.15rem 0.45rem; border-radius: 3px;
      background: rgba(96,165,250,0.1); color: var(--blue);
    }
    .chat-clear {
      background: none; border: none; color: var(--text-faint);
      font-size: 1rem; padding: 0.2rem 0.5rem; border-radius: 4px;
      transition: color 0.15s, background 0.15s;
    }
    .chat-clear:hover { color: var(--red); background: rgba(248,113,113,0.08); }

    .chat-log {
      flex: 1; min-height: 0; overflow-y: auto;
      padding: 1.5rem; display: flex; flex-direction: column; gap: 0.8rem;
    }
    .chat-empty { margin: auto 0; }
    .empty-line { font-size: 0.92rem; color: var(--text-muted); margin-bottom: 0.4rem; }
    .empty-line.dim { color: var(--text-faint); }
    .empty-suggestions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
    .suggestion {
      padding: 0.55rem 0.95rem; background: rgba(10,21,56,0.6);
      border: 1px solid var(--border); border-radius: 7px;
      color: var(--text-muted); font-size: 0.82rem;
      transition: all 0.15s;
    }
    .suggestion:hover {
      border-color: rgba(251,192,45,0.4);
      color: var(--gold);
      background: rgba(251,192,45,0.06);
    }

    .msg {
      max-width: 75%; padding: 0.7rem 0.95rem;
      border-radius: 11px; font-size: 0.88rem; line-height: 1.55;
      word-wrap: break-word; position: relative;
    }
    .msg-user {
      align-self: flex-end;
      background: rgba(251,192,45,0.12);
      border: 1px solid rgba(251,192,45,0.25);
      color: var(--text);
    }
    .msg-assistant {
      align-self: flex-start;
      background: rgba(10,21,56,0.6);
      border: 1px solid var(--border);
      color: var(--text-muted);
    }
    .stub-tag {
      display: inline-block; font-family: 'JetBrains Mono', monospace;
      font-size: 8px; letter-spacing: 0.15em; text-transform: uppercase;
      padding: 0.1rem 0.4rem; border-radius: 3px;
      background: rgba(96,165,250,0.15); color: var(--blue);
      margin-bottom: 0.4rem;
    }

    .chat-form {
      flex: 0 0 auto; display: flex; gap: 0.5rem;
      padding: 0.85rem 1rem;
      background: rgba(5,10,30,0.6); border-top: 1px solid var(--border);
    }
    #chatInput {
      flex: 1; padding: 0.65rem 0.85rem;
      background: rgba(10,21,56,0.6); border: 1px solid var(--border);
      border-radius: 8px; color: var(--text);
      font-family: inherit; font-size: 0.9rem;
      resize: none; outline: none; transition: border-color 0.15s;
    }
    #chatInput:focus { border-color: rgba(251,192,45,0.5); }
    #chatSend {
      align-self: flex-end; width: 38px; height: 38px;
      border: none; border-radius: 8px;
      background: linear-gradient(135deg, #fbc02d, #ff9500);
      color: #050a1e; font-weight: 700; font-size: 1.05rem;
      transition: opacity 0.15s;
    }
    #chatSend:disabled { opacity: 0.35; cursor: not-allowed; }

    /* Right: preview */
    .preview-tabs { display: flex; gap: 0.3rem; flex-wrap: wrap; }
    .tab {
      padding: 0.45rem 0.85rem; background: transparent;
      border: 1px solid var(--border); border-radius: 6px;
      color: var(--text-dim); font-family: 'JetBrains Mono', monospace;
      font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
      transition: all 0.15s;
    }
    .tab:hover { border-color: rgba(251,192,45,0.3); color: var(--text-muted); }
    .tab.active {
      background: rgba(251,192,45,0.1);
      border-color: rgba(251,192,45,0.4);
      color: var(--gold);
    }
    .preview-empty-tag {
      font-family: 'JetBrains Mono', monospace; font-size: 9px;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--text-faint);
    }
    .preview-body { flex: 1; position: relative; min-height: 0; }
    .preview-empty {
      padding: 3rem 1.5rem; text-align: center; color: var(--text-faint);
    }
    .preview-iframe {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      border: none; background: var(--bg);
      display: none;
    }
    .preview-iframe.active { display: block; }

    @media (max-width: 1200px) {
      .ws-layout { grid-template-columns: 240px 1fr 420px; }
    }
    @media (max-width: 900px) {
      .ws-layout { grid-template-columns: 1fr; height: auto; }
      .pane { height: auto; }
      .pane-left, .pane-right { border: none; border-bottom: 1px solid var(--border); }
      .pane-center { min-height: 60vh; }
      .preview-iframe { position: relative; height: 600px; }
    }
  </style>

  <script define:vars={{ id }}>
    // ── File upload ───────────────────────────────────────────────
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('fileInput');
    const fileList = document.getElementById('fileList');

    async function uploadFiles(files) {
      if (!files || files.length === 0) return;
      const fd = new FormData();
      for (const f of files) fd.append('file', f);
      dropzone.classList.add('over');
      try {
        const res = await fetch(`/api/workspaces/${id}/files`, { method: 'POST', body: fd });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error);
        window.location.reload();
      } catch (e) {
        alert('Error subiendo: ' + e.message);
      } finally {
        dropzone.classList.remove('over');
      }
    }

    dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('over'); });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('over'));
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadFiles(e.dataTransfer.files);
    });
    fileInput.addEventListener('change', () => uploadFiles(fileInput.files));

    document.querySelectorAll('.file-del').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault(); e.stopPropagation();
        const name = btn.dataset.name;
        if (!confirm(`Borrar ${name}?`)) return;
        try {
          const res = await fetch(`/api/workspaces/${id}/files?name=${encodeURIComponent(name)}`, { method: 'DELETE' });
          const data = await res.json();
          if (!data.ok) throw new Error(data.error);
          window.location.reload();
        } catch (err) { alert('Error: ' + err.message); }
      });
    });

    // ── Chat ──────────────────────────────────────────────────────
    const chatLog = document.getElementById('chatLog');
    const chatForm = document.getElementById('chatForm');
    const chatInput = document.getElementById('chatInput');
    const chatSend = document.getElementById('chatSend');
    const clearBtn = document.getElementById('clearChat');

    function scrollChatBottom() { chatLog.scrollTop = chatLog.scrollHeight; }
    scrollChatBottom();

    function appendMsg(role, content, stub) {
      const el = document.createElement('div');
      el.className = 'msg msg-' + role;
      if (role === 'assistant' && stub) {
        const tag = document.createElement('span');
        tag.className = 'stub-tag';
        tag.textContent = 'stub';
        el.appendChild(tag);
      }
      const p = document.createElement('p');
      p.textContent = content;
      el.appendChild(p);
      chatLog.appendChild(el);
      scrollChatBottom();
    }

    async function sendMessage(text) {
      if (!text.trim()) return;
      // Hide empty state
      const empty = chatLog.querySelector('.chat-empty');
      if (empty) empty.remove();

      appendMsg('user', text);
      chatInput.value = '';
      chatInput.disabled = true; chatSend.disabled = true;
      try {
        const res = await fetch(`/api/workspaces/${id}/chat`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        const data = await res.json();
        if (data.ok) {
          appendMsg('assistant', data.reply, true);
        } else {
          appendMsg('assistant', '⚠ ' + (data.error || 'error'), false);
        }
      } catch (e) {
        appendMsg('assistant', '⚠ ' + e.message, false);
      } finally {
        chatInput.disabled = false; chatSend.disabled = !chatInput.value.trim();
        chatInput.focus();
      }
    }

    chatInput.addEventListener('input', () => chatSend.disabled = !chatInput.value.trim());
    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); chatForm.requestSubmit(); }
    });
    chatForm.addEventListener('submit', (e) => { e.preventDefault(); sendMessage(chatInput.value); });

    document.querySelectorAll('.suggestion').forEach(btn => {
      btn.addEventListener('click', () => sendMessage(btn.dataset.prompt));
    });

    clearBtn.addEventListener('click', async () => {
      if (!confirm('¿Limpiar el historial de chat?')) return;
      await fetch(`/api/workspaces/${id}/chat`, { method: 'DELETE' });
      window.location.reload();
    });

    // ── Preview tabs ──────────────────────────────────────────────
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        const which = tab.dataset.tab;
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        document.querySelectorAll('.preview-iframe').forEach(f => f.classList.remove('active'));
        document.getElementById('frame-' + which)?.classList.add('active');
      });
    });
  </script>
</AppShell>
