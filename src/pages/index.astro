---
import AppShell from '../layouts/AppShell.astro';
import { listWorkspaces, WORKSPACE_TYPES } from '../lib/workspaces.mjs';
export const prerender = false;

const workspaces = listWorkspaces();

const TYPE_COLOR: Record<string, string> = {
  presentation: '#60a5fa',
  candidate:    '#fbc02d',
  vetting:      '#f87171',
  diagnostic:   '#4ade80',
  general:      '#94a3b8',
};

function timeAgo(iso: string) {
  if (!iso) return '';
  const m = Math.floor((Date.now() - new Date(iso).getTime()) / 60000);
  if (m < 1) return 'recién';
  if (m < 60) return `${m}m`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h`;
  return `${Math.floor(h / 24)}d`;
}
---
<AppShell title="Workspaces — Goberna" narrow={true}>
  <section style="margin-bottom: 2.5rem;">
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom: 0.4rem;">
      <h1 style="font-family:'Inter Tight',sans-serif; font-weight:900; font-size:2.2rem; letter-spacing:-0.025em;">
        Workspaces
      </h1>
      <a href="/w/new"
        style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.65rem 1.4rem; border-radius:8px; background:linear-gradient(90deg,#fbc02d,#ff9500); color:#050a1e; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.18em; text-transform:uppercase; font-weight:700; transition:transform 0.05s;"
        onmouseenter="this.style.transform='translateY(-1px)'"
        onmouseleave="this.style.transform='translateY(0)'">
        + Nuevo
      </a>
    </div>
    <p style="color:var(--text-dim); font-size:0.9rem; max-width:520px; line-height:1.5;">
      Cada workspace es un espacio aislado para un proyecto: subes archivos, conversas con Claude, y los outputs se generan automáticamente.
    </p>
  </section>

  {workspaces.length > 0 ? (
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:1rem;">
      {workspaces.map(w => {
        const color = TYPE_COLOR[w.type] ?? '#94a3b8';
        const typeLabel = (WORKSPACE_TYPES as any)[w.type] ?? w.type;
        return (
          <a href={`/w/${w.id}`}
            style="display:block; background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:1.4rem 1.4rem 1.2rem; transition:border-color 0.15s, transform 0.15s; position:relative; overflow:hidden;"
            onmouseenter="this.style.borderColor='rgba(251,192,45,0.35)'; this.style.transform='translateY(-2px)'"
            onmouseleave="this.style.borderColor='var(--border)'; this.style.transform='translateY(0)'">
            <div style={`position:absolute; top:0; left:0; right:0; height:3px; background:${color}; opacity:0.85;`}></div>
            <div style="display:flex; align-items:flex-start; gap:0.5rem; justify-content:space-between; margin-bottom:0.6rem;">
              <h2 style="font-family:'Inter Tight',sans-serif; font-weight:800; font-size:1.02rem; line-height:1.25;">
                {w.title}
              </h2>
              <span style={`flex-shrink:0; font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.15em; text-transform:uppercase; padding:0.18rem 0.5rem; border-radius:3px; background:${color}1a; color:${color};`}>
                {typeLabel}
              </span>
            </div>
            {w.tags && w.tags.length > 0 && (
              <p style="font-size:0.78rem; color:var(--text-dim); margin-bottom:0.5rem;">
                {w.tags.slice(0, 3).join(' · ')}
              </p>
            )}
            <div style="display:flex; align-items:center; gap:0.5rem; margin-top:0.75rem; padding-top:0.7rem; border-top:1px solid var(--border); font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; color:var(--text-faint);">
              <span>{timeAgo(w.updated)}</span>
              <span style="margin-left:auto; color:rgba(248,250,252,0.2);">→</span>
            </div>
          </a>
        );
      })}
    </div>
  ) : (
    <div style="background:var(--surface); border:1px dashed rgba(251,192,45,0.2); border-radius:14px; padding:3rem 2rem; text-align:center;">
      <p style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.25em; text-transform:uppercase; color:var(--gold); margin-bottom:0.75rem;">
        Sin workspaces aún
      </p>
      <p style="color:var(--text-dim); margin-bottom:1.75rem;">Crea el primero para empezar a trabajar.</p>
      <a href="/w/new"
        style="display:inline-block; padding:0.7rem 1.5rem; border-radius:8px; background:linear-gradient(90deg,#fbc02d,#ff9500); color:#050a1e; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.18em; text-transform:uppercase; font-weight:700;">
        + Nuevo workspace
      </a>
    </div>
  )}
</AppShell>
