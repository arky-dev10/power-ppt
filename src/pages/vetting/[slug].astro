---
import VettingLayout from '../../layouts/VettingLayout.astro';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  const dir = path.join(process.cwd(), 'vetting');
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir)
    .filter(n => !n.startsWith('.') && fs.existsSync(path.join(dir, n, 'profile.json')))
    .map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const base = path.join(process.cwd(), 'vetting', slug);
const profile = JSON.parse(fs.readFileSync(path.join(base, 'profile.json'), 'utf-8'));
const report  = fs.existsSync(path.join(base, 'report.json'))
  ? JSON.parse(fs.readFileSync(path.join(base, 'report.json'), 'utf-8'))
  : null;

const TIPO_LABEL: Record<string, string> = {
  'candidato-propio': 'Candidato propio',
  rival: 'Rival',
  aliado: 'Aliado',
};

const SEMAFORO_COLOR: Record<string, string> = {
  verde:    '#4ade80',
  amarillo: '#fbc02d',
  rojo:     '#f87171',
};
const SEMAFORO_LABEL: Record<string, string> = {
  verde:    'VERDE',
  amarillo: 'AMARILLO',
  rojo:     'ROJO',
};

const ACCION_LABEL: Record<string, string> = {
  'mitigacion-inmediata': 'Mitigación inmediata',
  'preparar-respuesta':   'Preparar respuesta',
  monitorear:             'Monitorear',
  archivar:               'Archivar',
};
const ACCION_COLOR: Record<string, string> = {
  'mitigacion-inmediata': '#f87171',
  'preparar-respuesta':   '#fbc02d',
  monitorear:             '#60a5fa',
  archivar:               '#64748b',
};

const PROB_COLOR: Record<string, string> = {
  alta: '#f87171', media: '#fbc02d', baja: '#4ade80',
};
const IMP_COLOR: Record<string, string> = {
  alto: '#f87171', medio: '#fbc02d', bajo: '#4ade80',
};

const RIESGO_COLOR: Record<string, string> = {
  alto:        '#f87171',
  'medio-alto':'#fb923c',
  medio:       '#fbc02d',
  'medio-bajo':'#a3e635',
  bajo:        '#4ade80',
};

const nivelLabels: Record<string, string> = {
  n1: 'N1 — Identidad',
  n2: 'N2 — Trayectoria y vida personal',
  n3: 'N3 — Riesgo legal y reputacional',
  n4: 'N4 — Solvencia y patrimonio',
  n5: 'N5 — Salud y capacidad funcional',
  entorno:    'Entorno',
  coherencia: 'Coherencia',
};

const niveles = ['n1','n2','n3','n4','n5','entorno','coherencia'] as const;
---

<VettingLayout title={`Perfil 5N — ${profile.meta.nombre}`}>

  <!-- Page header -->
  <div style="margin-bottom:2.5rem;">
    <p style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.3em; text-transform:uppercase; color:#fbc02d; margin-bottom:0.75rem;">
      Perfil 5N · Análisis de candidato
    </p>
    <h1 style="font-family:'Inter Tight',sans-serif; font-weight:900; font-size:2.4rem; letter-spacing:-0.025em; color:#f8fafc; line-height:1.1; margin-bottom:0.5rem;">
      {profile.meta.nombre}
    </h1>
    <div style="display:flex; flex-wrap:wrap; gap:0.75rem; align-items:center;">
      <span style="font-size:0.8rem; color:#64748b;">{profile.meta.cargo}</span>
      <span style="color:#1e293b;">·</span>
      <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.15em; text-transform:uppercase; padding:0.25rem 0.6rem; border-radius:4px; background:rgba(251,192,45,0.1); border:1px solid rgba(251,192,45,0.2); color:#fbc02d;">
        {TIPO_LABEL[profile.meta.tipo] ?? profile.meta.tipo}
      </span>
      <span style="color:#1e293b;">·</span>
      <span style="font-size:0.8rem; color:#64748b;">{profile.meta.eleccion}</span>
      <span style="color:#1e293b;">·</span>
      <span style="font-size:0.8rem; color:#475569;">{report ? `Análisis: ${report.generado}` : 'Sin análisis generado'}</span>
    </div>
    <div style="width:48px; height:3px; background:linear-gradient(90deg,#fbc02d,#ff9500); border-radius:2px; margin-top:1.25rem;"></div>
  </div>

  {report ? (
    <>
      <!-- Scorecard + Conclusión -->
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1.5rem;">

        <!-- Scorecard -->
        <div style="background:rgba(10,21,56,0.6); border:1px solid rgba(251,192,45,0.15); border-radius:12px; padding:1.5rem;">
          <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:#475569; margin-bottom:1.25rem;">Scorecard</p>
          <div style="display:flex; flex-direction:column; gap:0.6rem;">
            {niveles.map((k, i) => {
              const s = report.scorecard[k];
              if (!s) return null;
              const color = SEMAFORO_COLOR[s.semaforo] ?? '#64748b';
              const isSep = i === 5;
              return (
                <>
                  {isSep && <div style="height:1px; background:rgba(248,250,252,0.06); margin:0.25rem 0;"></div>}
                  <div style="display:flex; align-items:center; gap:0.75rem;">
                    <div style={`width:10px; height:10px; border-radius:50%; background:${color}; flex-shrink:0; box-shadow:0 0 8px ${color}66;`}></div>
                    <span style="font-size:0.78rem; color:#94a3b8; flex:1;">{nivelLabels[k]}</span>
                    <span style={`font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; color:${color};`}>
                      {SEMAFORO_LABEL[s.semaforo]}
                    </span>
                  </div>
                </>
              );
            })}
          </div>
        </div>

        <!-- Conclusión ejecutiva -->
        <div style="background:rgba(10,21,56,0.6); border:1px solid rgba(251,192,45,0.15); border-radius:12px; padding:1.5rem; display:flex; flex-direction:column; gap:1rem;">
          <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:#475569;">Conclusión ejecutiva</p>
          <p style="font-size:0.82rem; line-height:1.7; color:#cbd5e1; flex:1;">
            {report.conclusion_ejecutiva}
          </p>
          {report.riesgo_global && (
            <div style="display:flex; align-items:center; gap:0.6rem; margin-top:auto; padding-top:1rem; border-top:1px solid rgba(248,250,252,0.06);">
              <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#64748b;">Riesgo global</span>
              <div style={`width:8px; height:8px; border-radius:50%; background:${RIESGO_COLOR[report.riesgo_global] ?? '#64748b'}; box-shadow:0 0 8px ${RIESGO_COLOR[report.riesgo_global] ?? '#64748b'}66;`}></div>
              <span style={`font-family:'JetBrains Mono',monospace; font-size:10px; font-weight:600; color:${RIESGO_COLOR[report.riesgo_global] ?? '#64748b'}; text-transform:uppercase; letter-spacing:0.1em;`}>
                {report.riesgo_global.replace('-', ' ')}
              </span>
            </div>
          )}
        </div>
      </div>

      <!-- Riesgos críticos -->
      {report.riesgos?.length > 0 && (
        <div style="margin-bottom:1.5rem;">
          <h2 style="font-family:'Inter Tight',sans-serif; font-weight:800; font-size:1rem; letter-spacing:-0.01em; color:#f8fafc; margin-bottom:1rem;">
            Riesgos críticos
          </h2>
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            {report.riesgos.map((r: any) => (
              <div style="background:rgba(10,21,56,0.5); border:1px solid rgba(248,250,252,0.06); border-radius:10px; padding:1.25rem; border-left:3px solid rgba(251,192,45,0.3);">
                <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; margin-bottom:0.75rem;">
                  <div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
                    <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:#64748b; background:rgba(248,250,252,0.05); padding:0.2rem 0.5rem; border-radius:3px;">
                      {r.nivel}
                    </span>
                    <span style={`font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; padding:0.2rem 0.5rem; border-radius:3px; background:${ACCION_COLOR[r.accion]}22; color:${ACCION_COLOR[r.accion]};`}>
                      {ACCION_LABEL[r.accion] ?? r.accion}
                    </span>
                  </div>
                  <div style="display:flex; align-items:center; gap:0.5rem; flex-shrink:0;">
                    <span style={`font-size:0.7rem; color:${PROB_COLOR[r.probabilidad]};`}>P: {r.probabilidad}</span>
                    <span style="color:#1e293b;">×</span>
                    <span style={`font-size:0.7rem; color:${IMP_COLOR[r.impacto]};`}>I: {r.impacto}</span>
                  </div>
                </div>
                <p style="font-size:0.85rem; color:#e2e8f0; line-height:1.5; margin-bottom:0.75rem;">{r.hallazgo}</p>
                {r.mensaje_preparado && (
                  <div style="background:rgba(5,10,30,0.5); border-left:2px solid rgba(251,192,45,0.3); padding:0.75rem 1rem; border-radius:0 6px 6px 0; margin-bottom:0.5rem;">
                    <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.35rem;">Mensaje preparado</p>
                    <p style="font-size:0.8rem; color:#94a3b8; line-height:1.6; font-style:italic;">"{r.mensaje_preparado}"</p>
                  </div>
                )}
                {(r.vocero || r.material_respaldo?.length > 0) && (
                  <div style="display:flex; gap:1.5rem; margin-top:0.5rem;">
                    {r.vocero && (
                      <div>
                        <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:#475569; margin-bottom:0.2rem;">Vocero</p>
                        <p style="font-size:0.78rem; color:#64748b;">{r.vocero}</p>
                      </div>
                    )}
                    {r.material_respaldo?.length > 0 && (
                      <div>
                        <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:#475569; margin-bottom:0.2rem;">Material de respaldo</p>
                        <ul style="list-style:none; display:flex; flex-direction:column; gap:0.15rem;">
                          {r.material_respaldo.map((m: string) => (
                            <li style="font-size:0.78rem; color:#64748b;">· {m}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Detalle por nivel -->
      <h2 style="font-family:'Inter Tight',sans-serif; font-weight:800; font-size:1rem; letter-spacing:-0.01em; color:#f8fafc; margin-bottom:1rem;">
        Detalle por nivel
      </h2>
      <div style="display:flex; flex-direction:column; gap:0.6rem; margin-bottom:1.5rem;">
        {niveles.map((k, i) => {
          const s = report.scorecard[k];
          if (!s) return null;
          const color = SEMAFORO_COLOR[s.semaforo] ?? '#64748b';
          return (
            <details style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.06); border-radius:8px; overflow:hidden;">
              <summary style={`display:flex; align-items:center; gap:0.75rem; padding:0.9rem 1.1rem; cursor:pointer; list-style:none; border-left:3px solid ${color};`}>
                <div style={`width:8px; height:8px; border-radius:50%; background:${color}; flex-shrink:0;`}></div>
                <span style="font-size:0.85rem; color:#e2e8f0; flex:1;">{nivelLabels[k]}</span>
                <span style={`font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; color:${color};`}>
                  {SEMAFORO_LABEL[s.semaforo]}
                </span>
              </summary>
              <div style="padding:0.75rem 1.1rem 1rem 2.5rem; border-top:1px solid rgba(248,250,252,0.04);">
                <p style="font-size:0.8rem; color:#94a3b8; line-height:1.6; margin-bottom:0.5rem;">{s.nota}</p>
                {s.hallazgos?.length > 0 && (
                  <ul style="list-style:none; display:flex; flex-direction:column; gap:0.3rem; margin-top:0.5rem;">
                    {s.hallazgos.map((h: string) => (
                      <li style="font-size:0.8rem; color:#cbd5e1; display:flex; align-items:flex-start; gap:0.5rem;">
                        <span style={`color:${color}; flex-shrink:0; margin-top:0.1rem;`}>▸</span>
                        {h}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </details>
          );
        })}
      </div>
    </>
  ) : (
    <!-- Sin análisis -->
    <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(251,192,45,0.1); border-radius:12px; padding:2rem; text-align:center; margin-bottom:2rem;">
      <p style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.25em; text-transform:uppercase; color:#fbc02d; margin-bottom:0.75rem;">Perfil incompleto</p>
      <p style="font-size:0.9rem; color:#64748b; line-height:1.6;">
        Los datos del candidato están guardados en <code style="color:#94a3b8;">profile.json</code> pero el análisis aún no fue generado.<br/>
        Pídele a Claude: <em style="color:#94a3b8;">"Genera el reporte 5N de {profile.meta.nombre}"</em>
      </p>
    </div>
  )}

  <!-- Datos en bruto (collapsible) -->
  <details style="background:rgba(10,21,56,0.3); border:1px solid rgba(248,250,252,0.05); border-radius:8px; overflow:hidden;">
    <summary style="padding:0.9rem 1.1rem; cursor:pointer; list-style:none; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.25em; text-transform:uppercase; color:#475569;">
      Datos de perfil ingresados
    </summary>
    <div style="padding:0 1.1rem 1rem; border-top:1px solid rgba(248,250,252,0.04);">
      {(['n1','n2','n3','n4','n5','entorno','coherencia'] as const).map(k => {
        const data = profile[k];
        if (!data) return null;
        const notas = data.notas;
        return (
          <div style="padding:0.75rem 0; border-bottom:1px solid rgba(248,250,252,0.04);">
            <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#64748b; margin-bottom:0.35rem;">{nivelLabels[k]}</p>
            {notas && <p style="font-size:0.78rem; color:#475569; line-height:1.5;">{notas}</p>}
          </div>
        );
      })}
    </div>
  </details>

  <!-- Footer -->
  <div style="margin-top:2rem; padding-top:1.5rem; border-top:1px solid rgba(248,250,252,0.05); display:flex; justify-content:space-between; align-items:center;">
    <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:#1e3a5f;">
      Goberna · Análisis del Perfil del Candidato · Modelo 5N
    </span>
    {report?.fecha_proxima_revision && (
      <span style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#334155;">
        Próxima revisión: {report.fecha_proxima_revision}
      </span>
    )}
  </div>

</VettingLayout>
