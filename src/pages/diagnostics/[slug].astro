---
import VettingLayout from '../../layouts/VettingLayout.astro';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  const dir = path.join(process.cwd(), 'diagnostics');
  if (!fs.existsSync(dir)) return [];
  return fs.readdirSync(dir)
    .filter(n => !n.startsWith('.') && !n.startsWith('_') && fs.existsSync(path.join(dir, n, 'territorial.json')))
    .map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const base = path.join(process.cwd(), 'diagnostics', slug);
const t = JSON.parse(fs.readFileSync(path.join(base, 'territorial.json'), 'utf-8'));

const NIVEL_LABEL: Record<string,string> = {
  distrital: 'Distrito', provincial: 'Provincia', regional: 'Región', nacional: 'Nacional',
};

const CLEAVAGE_LABEL: Record<string,string> = {
  centro_periferia: 'Centro / Periferia',
  urbano_rural: 'Urbano / Rural',
  capital_trabajo: 'Capital / Trabajo',
  tradicional_moderno: 'Tradicional / Moderno',
  etnico_linguistico: 'Étnico-lingüístico',
  religioso: 'Religioso',
};

const CONFIANZA_LABEL: Record<string,string> = {
  gobierno_nacional: 'Gob. Nacional',
  gobierno_local: 'Gob. Local',
  congreso: 'Congreso',
  poder_judicial: 'Poder Judicial',
  policia: 'Policía',
  iglesia: 'Iglesia',
  medios: 'Medios',
};

const CLIMA_LABEL: Record<string,string> = {
  miedo: 'Miedo', esperanza: 'Esperanza', indignacion: 'Indignación',
  resignacion: 'Resignación', orgullo: 'Orgullo', nostalgia: 'Nostalgia',
};

const SEGMENT_COLORS = ['#fbc02d','#60a5fa','#4ade80','#c084fc','#fb923c','#f87171'];

function bar(val: number, max: number = 5, color = '#fbc02d') {
  const pct = Math.round((val / max) * 100);
  return `<div style="display:flex;align-items:center;gap:0.5rem;"><div style="flex:1;height:4px;background:rgba(248,250,252,0.06);border-radius:2px;overflow:hidden;"><div style="height:100%;width:${pct}%;background:${color};border-radius:2px;"></div></div><span style="font-family:'JetBrains Mono',monospace;font-size:9px;color:${color};">${val}</span></div>`;
}

const segs: any[] = t.c?.c2?.segmentos ?? [];
const matriz: any[] = t.d?.d5?.matriz ?? [];
const issues: any[] = [...(t.c?.c5?.issues ?? [])].sort((a,b) => b.urgencia - a.urgencia);
const competidores: any[] = t.d?.d3?.competidores ?? [];
const elecciones: any[] = t.d?.d2?.elecciones ?? [];
const figuras: any[] = t.e?.e4?.figuras ?? [];
const confianza = t.c?.c3?.confianza_institucional ?? {};
const clima = t.c?.c3?.clima_emocional ?? {};
---

<VettingLayout title={`Diagnóstico — ${t.meta.nombre_territorio}`}>

  <!-- Header -->
  <div style="margin-bottom:2.5rem;">
    <p style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.3em; text-transform:uppercase; color:#fbc02d; margin-bottom:0.75rem;">
      Diagnóstico Territorial · ECD
    </p>
    <h1 style="font-family:'Inter Tight',sans-serif; font-weight:900; font-size:2.4rem; letter-spacing:-0.025em; color:#f8fafc; line-height:1.1; margin-bottom:0.5rem;">
      {t.meta.nombre_territorio}
    </h1>
    <div style="display:flex; flex-wrap:wrap; gap:0.75rem; align-items:center;">
      <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; padding:0.25rem 0.6rem; border-radius:4px; background:rgba(251,192,45,0.1); border:1px solid rgba(251,192,45,0.2); color:#fbc02d;">
        {NIVEL_LABEL[t.meta.nivel] ?? t.meta.nivel}
      </span>
      <span style="font-size:0.8rem; color:#64748b;">{t.meta.eleccion_cargo} · {t.meta.eleccion_año}</span>
      <span style="color:#1e293b;">·</span>
      <span style="font-size:0.8rem; color:#475569;">{t.meta.fecha}</span>
    </div>
    <div style="width:48px; height:3px; background:linear-gradient(90deg,#fbc02d,#ff9500); border-radius:2px; margin-top:1.25rem;"></div>
  </div>

  <!-- KPIs rápidos -->
  <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:0.75rem; margin-bottom:1.5rem;">
    {[
      { label: 'Población', value: t.e?.e1?.poblacion_total?.toLocaleString('es-PE') ?? '—' },
      { label: 'Electores', value: t.d?.d1?.total_electores?.toLocaleString('es-PE') ?? '—' },
      { label: 'IDH', value: t.e?.e2?.idh ?? '—' },
      { label: 'Participación anterior', value: t.d?.d1?.participacion_anterior ? `${t.d.d1.participacion_anterior}%` : '—' },
    ].map(k => (
      <div style="background:rgba(10,21,56,0.5); border:1px solid rgba(248,250,252,0.06); border-radius:8px; padding:1rem; text-align:center;">
        <p style="font-family:'JetBrains Mono',monospace; font-size:1.4rem; font-weight:400; color:#f8fafc; letter-spacing:-0.02em;">{k.value}</p>
        <p style="font-size:0.68rem; color:#475569; text-transform:uppercase; letter-spacing:0.1em; margin-top:0.25rem;">{k.label}</p>
      </div>
    ))}
  </div>

  <!-- E + C + D columns -->
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:1rem;">

    <!-- === ESTRUCTURA === -->
    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      <h2 style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:#fbc02d; padding-bottom:0.5rem; border-bottom:1px solid rgba(251,192,45,0.15);">
        E — Estructura
      </h2>

      <!-- E1 Demografía -->
      <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.05); border-radius:8px; padding:1rem;">
        <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.75rem;">E1 · Demografía</p>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem 1rem;">
          {[
            ['Urbana/Rural', `${t.e?.e1?.pct_urbana}% / ${t.e?.e1?.pct_rural}%`],
            ['Crecimiento', `${t.e?.e1?.tasa_crecimiento}% anual`],
            ['Densidad', `${t.e?.e1?.densidad} hab/km²`],
            ['División', t.e?.e1?.division_politica],
          ].map(([l,v]) => v && (
            <div>
              <p style="font-size:0.65rem; color:#475569; margin-bottom:0.1rem;">{l}</p>
              <p style="font-size:0.78rem; color:#94a3b8;">{v}</p>
            </div>
          ))}
        </div>
        <!-- Pirámide etaria simplificada -->
        {t.e?.e1?.piramide_etaria && (
          <div style="margin-top:0.75rem;">
            <p style="font-size:0.65rem; color:#475569; margin-bottom:0.4rem;">Pirámide etaria</p>
            <div style="display:flex; flex-direction:column; gap:0.3rem;">
              {Object.entries(t.e.e1.piramide_etaria).map(([rango, pct]: [string, any]) => (
                <div style="display:flex; align-items:center; gap:0.5rem;">
                  <span style="font-size:0.65rem; color:#475569; width:36px; flex-shrink:0;">{rango}</span>
                  <div style="flex:1; height:4px; background:rgba(248,250,252,0.06); border-radius:2px;">
                    <div style={`height:100%; width:${pct * 2}%; background:#60a5fa; border-radius:2px;`}></div>
                  </div>
                  <span style="font-family:'JetBrains Mono',monospace; font-size:8px; color:#64748b;">{pct}%</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- E2 Económico -->
      <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.05); border-radius:8px; padding:1rem;">
        <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.75rem;">E2 · Capital Económico</p>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.5rem 1rem; margin-bottom:0.75rem;">
          {[
            ['Informalidad', `${t.e?.e2?.pct_informalidad}%`],
            ['Desempleo', `${t.e?.e2?.desempleo}%`],
            ['Pobreza', `${t.e?.e2?.indice_pobreza}%`],
            ['Ejec. presup.', `${t.e?.e2?.pct_ejecucion}%`],
          ].map(([l,v]) => v && (
            <div>
              <p style="font-size:0.65rem; color:#475569; margin-bottom:0.1rem;">{l}</p>
              <p style="font-size:0.78rem; color:#94a3b8;">{v}</p>
            </div>
          ))}
        </div>
        {t.e?.e2?.actividad_dominante && <p style="font-size:0.75rem; color:#64748b;">Actividad: {t.e.e2.actividad_dominante}</p>}
      </div>

      <!-- E4 Campo Político -->
      {figuras.length > 0 && (
        <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.05); border-radius:8px; padding:1rem;">
          <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.75rem;">E4 · Campo Político</p>
          <div style="display:flex; flex-direction:column; gap:0.5rem;">
            {figuras.map((f: any) => (
              <div style="display:flex; align-items:center; gap:0.6rem;">
                <div style="flex:1;">
                  <p style="font-size:0.78rem; color:#e2e8f0;">{f.nombre}</p>
                  <p style="font-size:0.68rem; color:#475569;">{f.rol}</p>
                </div>
                <div style="display:flex; gap:2px;">
                  {[1,2,3,4,5].map(n => (
                    <div style={`width:6px; height:6px; border-radius:1px; background:${n <= f.influencia ? '#fbc02d' : 'rgba(248,250,252,0.08)'};`}></div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          {t.e?.e4?.nombres_quemados?.length > 0 && (
            <div style="margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid rgba(248,250,252,0.05);">
              <p style="font-size:0.65rem; color:#475569; margin-bottom:0.3rem;">Nombres quemados</p>
              {t.e.e4.nombres_quemados.map((n: string) => (
                <p style="font-size:0.72rem; color:#f87171;">· {n}</p>
              ))}
            </div>
          )}
        </div>
      )}

      <!-- E5 Cleavages -->
      <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.05); border-radius:8px; padding:1rem;">
        <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.75rem;">E5 · Cleavages activos</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">
          {Object.entries(t.e?.e5 ?? {}).filter(([k,v]) => v === true).map(([k]) => (
            <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.1em; padding:0.25rem 0.6rem; border-radius:4px; background:rgba(251,192,45,0.08); border:1px solid rgba(251,192,45,0.2); color:#fbc02d;">
              {CLEAVAGE_LABEL[k] ?? k}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- === CONCIENCIA === -->
    <div style="display:flex; flex-direction:column; gap:0.75rem;">
      <h2 style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:#60a5fa; padding-bottom:0.5rem; border-bottom:1px solid rgba(96,165,250,0.15);">
        C — Conciencia
      </h2>

      <!-- C2 Segmentos -->
      {segs.length > 0 && (
        <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(96,165,250,0.12); border-radius:8px; padding:1rem;">
          <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#60a5fa; margin-bottom:0.75rem;">C2 ★ Segmentos psicográficos</p>
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            {segs.map((s: any, i: number) => (
              <div style={`border-left:2px solid ${SEGMENT_COLORS[i % SEGMENT_COLORS.length]}; padding-left:0.75rem;`}>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:0.25rem;">
                  <p style={`font-size:0.82rem; font-weight:600; color:${SEGMENT_COLORS[i % SEGMENT_COLORS.length]};`}>{s.nombre}</p>
                  <span style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#475569;">{s.pct_aprox}%</span>
                </div>
                <p style="font-size:0.72rem; color:#64748b; line-height:1.4; margin-bottom:0.15rem;">↑ {s.aspiraciones}</p>
                <p style="font-size:0.72rem; color:#64748b; line-height:1.4;">↓ {s.temores}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- C3 Clima + Confianza -->
      <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.05); border-radius:8px; padding:1rem;">
        <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.75rem;">C3 · Clima emocional</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-bottom:1rem;">
          {Object.entries(clima).filter(([k,v]) => v === true && k !== 'otro').map(([k]) => (
            <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.1em; padding:0.2rem 0.5rem; border-radius:3px; background:rgba(248,250,252,0.06); color:#94a3b8;">
              {CLIMA_LABEL[k] ?? k}
            </span>
          ))}
        </div>
        <p style="font-size:0.68rem; color:#475569; margin-bottom:0.5rem; text-transform:uppercase; letter-spacing:0.1em;">Confianza institucional (1–5)</p>
        <div style="display:flex; flex-direction:column; gap:0.35rem;">
          {Object.entries(confianza).map(([k, v]: [string, any]) => (
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span style="font-size:0.65rem; color:#475569; width:88px; flex-shrink:0;">{CONFIANZA_LABEL[k] ?? k}</span>
              <div style="flex:1; height:4px; background:rgba(248,250,252,0.06); border-radius:2px;">
                <div style={`height:100%; width:${(v/5)*100}%; background:${v >= 4 ? '#4ade80' : v >= 3 ? '#fbc02d' : '#f87171'}; border-radius:2px;`}></div>
              </div>
              <span style="font-family:'JetBrains Mono',monospace; font-size:8px; color:#64748b;">{v}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- C5 Issues -->
      {issues.length > 0 && (
        <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.05); border-radius:8px; padding:1rem;">
          <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.75rem;">C5 · Issues prioritarios</p>
          <div style="display:flex; flex-direction:column; gap:0.4rem;">
            {issues.slice(0,8).map((iss: any, i: number) => (
              <div style="display:flex; align-items:center; gap:0.6rem;">
                <span style="font-family:'JetBrains Mono',monospace; font-size:8px; color:#334155; width:14px; flex-shrink:0;">{i+1}</span>
                <div style="flex:1; height:4px; background:rgba(248,250,252,0.06); border-radius:2px;">
                  <div style={`height:100%; width:${(iss.urgencia/5)*100}%; background:${iss.urgencia >= 5 ? '#f87171' : iss.urgencia >= 4 ? '#fbc02d' : '#64748b'}; border-radius:2px;`}></div>
                </div>
                <span style="font-size:0.72rem; color:#94a3b8; flex:1;">{iss.tema}</span>
                {iss.visible_medios && <span style="font-size:0.6rem; color:#475569; flex-shrink:0;">📡</span>}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  <!-- === DECISIÓN (full width) === -->
  <div style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:1.5rem;">
    <h2 style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:#4ade80; padding-bottom:0.5rem; border-bottom:1px solid rgba(74,222,128,0.15);">
      D — Decisión
    </h2>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
      <!-- D2 Historia electoral -->
      {elecciones.length > 0 && (
        <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.05); border-radius:8px; padding:1rem;">
          <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.75rem;">D2 · Historia electoral</p>
          <div style="display:flex; flex-direction:column; gap:0.5rem;">
            {elecciones.map((e: any) => (
              <div style="display:flex; align-items:baseline; gap:0.75rem; padding:0.5rem 0; border-bottom:1px solid rgba(248,250,252,0.04);">
                <span style="font-family:'JetBrains Mono',monospace; font-size:10px; color:#475569; flex-shrink:0;">{e.año}</span>
                <div style="flex:1;">
                  <p style="font-size:0.8rem; color:#f8fafc;">{e.ganador} <span style="color:#4ade80; font-family:'JetBrains Mono',monospace; font-size:9px;">{e.pct}%</span></p>
                  <p style="font-size:0.68rem; color:#475569;">{e.segundo} {e.pct2}% · margen {e.margen}pp</p>
                </div>
              </div>
            ))}
          </div>
          {t.d?.d2?.bastiones && <p style="font-size:0.72rem; color:#475569; margin-top:0.5rem; line-height:1.5;">{t.d.d2.bastiones}</p>}
        </div>
      )}

      <!-- D3 Competidores -->
      {competidores.length > 0 && (
        <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(248,250,252,0.05); border-radius:8px; padding:1rem;">
          <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#475569; margin-bottom:0.75rem;">D3 · Competidores</p>
          <div style="display:flex; flex-direction:column; gap:0.6rem;">
            {competidores.map((c: any) => (
              <div style="padding:0.6rem; background:rgba(5,10,30,0.4); border-radius:6px; border:1px solid rgba(248,250,252,0.04);">
                <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:0.25rem;">
                  <p style="font-size:0.82rem; color:#f8fafc;">{c.candidato}</p>
                  <span style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#fbc02d;">techo {c.techo_estimado}%</span>
                </div>
                <p style="font-size:0.68rem; color:#475569;">{c.partido} · {c.capital_dominante}</p>
              </div>
            ))}
          </div>

          <!-- D4 snapshot -->
          {t.d?.d4 && (
            <div style="margin-top:0.75rem; padding-top:0.75rem; border-top:1px solid rgba(248,250,252,0.05);">
              <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.3rem;">
                <span style="font-size:0.68rem; color:#475569;">Aprobación saliente:</span>
                <span style={`font-family:'JetBrains Mono',monospace; font-size:10px; color:${(t.d.d4.aprobacion_saliente ?? 0) < 40 ? '#f87171' : '#4ade80'};`}>{t.d.d4.aprobacion_saliente}%</span>
                <span style={`font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.1em; padding:0.15rem 0.4rem; border-radius:3px; background:${t.d.d4.clima_continuidad_castigo === 'castigo' ? 'rgba(248,113,113,0.1)' : 'rgba(74,222,128,0.1)'}; color:${t.d.d4.clima_continuidad_castigo === 'castigo' ? '#f87171' : '#4ade80'};`}>
                  {t.d.d4.clima_continuidad_castigo}
                </span>
              </div>
              {t.d.d4.issue_decisivo && <p style="font-size:0.72rem; color:#64748b;">Issue decisivo: <span style="color:#94a3b8;">{t.d.d4.issue_decisivo}</span></p>}
            </div>
          )}
        </div>
      )}
    </div>

    <!-- D5 Matriz de decisión (★ linked to C2) -->
    {matriz.length > 0 && (
      <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(74,222,128,0.12); border-radius:8px; padding:1rem;">
        <p style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#4ade80; margin-bottom:0.75rem;">D5 ★ Matriz de decisión por segmento</p>
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; font-size:0.78rem;">
            <thead>
              <tr>
                {['Segmento', 'Preferencia actual', 'Razón principal', 'Voto útil', 'Prob. cambio'].map(h => (
                  <th style="text-align:left; padding:0.4rem 0.6rem; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.12em; text-transform:uppercase; color:#475569; border-bottom:1px solid rgba(248,250,252,0.06);">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {matriz.map((row: any, i: number) => {
                const color = SEGMENT_COLORS[segs.findIndex((s:any) => s.nombre === row.segmento) % SEGMENT_COLORS.length] ?? SEGMENT_COLORS[i % SEGMENT_COLORS.length];
                const probColor = row.prob_cambio === 'alta' ? '#4ade80' : row.prob_cambio === 'media' ? '#fbc02d' : '#f87171';
                return (
                  <tr style="border-bottom:1px solid rgba(248,250,252,0.04);">
                    <td style={`padding:0.5rem 0.6rem; color:${color}; font-weight:600;`}>{row.segmento}</td>
                    <td style="padding:0.5rem 0.6rem; color:#94a3b8;">{row.candidato_preferido}</td>
                    <td style="padding:0.5rem 0.6rem; color:#64748b; font-size:0.72rem;">{row.razon_principal}</td>
                    <td style="padding:0.5rem 0.6rem; text-align:center;">
                      <span style={`font-family:'JetBrains Mono',monospace; font-size:9px; color:${row.voto_util ? '#fbc02d' : '#334155'};`}>{row.voto_util ? 'Sí' : 'No'}</span>
                    </td>
                    <td style="padding:0.5rem 0.6rem;">
                      <span style={`font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.08em; color:${probColor};`}>{row.prob_cambio}</span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>

  <!-- E3 + C4 + C6 colapsables -->
  <div style="display:flex; flex-direction:column; gap:0.5rem; margin-bottom:1.5rem;">
    <h2 style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:#64748b; margin-bottom:0.25rem;">Detalle adicional</h2>

    {t.e?.e3 && (
      <details style="background:rgba(10,21,56,0.3); border:1px solid rgba(248,250,252,0.05); border-radius:8px; overflow:hidden;">
        <summary style="padding:0.75rem 1rem; cursor:pointer; list-style:none; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#475569;">E3 · Capital Cultural y Social</summary>
        <div style="padding:0.75rem 1rem 1rem; border-top:1px solid rgba(248,250,252,0.04); font-size:0.8rem; color:#64748b; line-height:1.6; display:flex; flex-direction:column; gap:0.3rem;">
          {t.e.e3.etnias_lenguas && <p><span style="color:#475569;">Etnias/lenguas:</span> {t.e.e3.etnias_lenguas}</p>}
          {t.e.e3.religion_predominante && <p><span style="color:#475569;">Religión:</span> {t.e.e3.religion_predominante}</p>}
          {t.e.e3.nivel_educativo && <p><span style="color:#475569;">Educación:</span> {t.e.e3.nivel_educativo}</p>}
          {t.e.e3.organizaciones_base?.length > 0 && <p><span style="color:#475569;">Org. base:</span> {t.e.e3.organizaciones_base.join(', ')}</p>}
        </div>
      </details>
    )}

    {t.c?.c4 && (
      <details style="background:rgba(10,21,56,0.3); border:1px solid rgba(248,250,252,0.05); border-radius:8px; overflow:hidden;">
        <summary style="padding:0.75rem 1rem; cursor:pointer; list-style:none; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#475569;">C4 · Memoria política</summary>
        <div style="padding:0.75rem 1rem 1rem; border-top:1px solid rgba(248,250,252,0.04); display:flex; flex-direction:column; gap:0.5rem;">
          {t.c.c4.hitos_positivos?.length > 0 && (
            <div>
              <p style="font-size:0.65rem; color:#4ade80; margin-bottom:0.25rem; text-transform:uppercase; letter-spacing:0.1em;">Hitos positivos</p>
              {t.c.c4.hitos_positivos.map((h: string) => <p style="font-size:0.78rem; color:#64748b;">· {h}</p>)}
            </div>
          )}
          {t.c.c4.hitos_traumaticos?.length > 0 && (
            <div>
              <p style="font-size:0.65rem; color:#f87171; margin-bottom:0.25rem; text-transform:uppercase; letter-spacing:0.1em;">Hitos traumáticos</p>
              {t.c.c4.hitos_traumaticos.map((h: string) => <p style="font-size:0.78rem; color:#64748b;">· {h}</p>)}
            </div>
          )}
        </div>
      </details>
    )}

    {t.c?.c6 && (
      <details style="background:rgba(10,21,56,0.3); border:1px solid rgba(248,250,252,0.05); border-radius:8px; overflow:hidden;">
        <summary style="padding:0.75rem 1rem; cursor:pointer; list-style:none; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.2em; text-transform:uppercase; color:#475569;">C6 · Ecosistema de medios y opinión</summary>
        <div style="padding:0.75rem 1rem 1rem; border-top:1px solid rgba(248,250,252,0.04);">
          {t.c.c6.medios?.length > 0 && (
            <div style="margin-bottom:0.75rem;">
              <p style="font-size:0.65rem; color:#475569; margin-bottom:0.4rem; text-transform:uppercase; letter-spacing:0.1em;">Medios</p>
              <div style="display:flex; flex-direction:column; gap:0.25rem;">
                {t.c.c6.medios.map((m: any) => (
                  <p style="font-size:0.75rem; color:#64748b;">{m.nombre} <span style="color:#334155;">({m.tipo} · {m.linea_editorial})</span></p>
                ))}
              </div>
            </div>
          )}
          {t.c.c6.encuestas?.length > 0 && (
            <div>
              <p style="font-size:0.65rem; color:#475569; margin-bottom:0.4rem; text-transform:uppercase; letter-spacing:0.1em;">Encuestas</p>
              {t.c.c6.encuestas.map((e: any) => (
                <div style="padding:0.5rem; background:rgba(5,10,30,0.4); border-radius:4px; margin-bottom:0.25rem;">
                  <p style="font-size:0.68rem; color:#475569;">{e.encuestadora} · {e.fecha} · n={e.muestra}</p>
                  <p style="font-size:0.75rem; color:#94a3b8; margin-top:0.2rem;">{e.hallazgos}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </details>
    )}
  </div>

  <!-- Footer -->
  <div style="padding-top:1.5rem; border-top:1px solid rgba(248,250,252,0.05); display:flex; justify-content:space-between; align-items:center;">
    <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:#1e3a5f;">
      Goberna · Instrumento de Diagnóstico Territorial · ECD
    </span>
    <span style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#334155;">{t.meta.fecha}</span>
  </div>

</VettingLayout>
