---
import VettingLayout from '../../layouts/VettingLayout.astro';
import fs from 'fs';
import path from 'path';

const dir = path.join(process.cwd(), 'diagnostics');
const items: any[] = [];

if (fs.existsSync(dir)) {
  fs.readdirSync(dir, { withFileTypes: true })
    .filter(d => d.isDirectory() && !d.name.startsWith('_') && !d.name.startsWith('.'))
    .forEach(d => {
      const tPath = path.join(dir, d.name, 'territorial.json');
      if (!fs.existsSync(tPath)) return;
      const t = JSON.parse(fs.readFileSync(tPath, 'utf-8'));
      items.push({ slug: d.name, meta: t.meta });
    });
}

const NIVEL_COLOR: Record<string,string> = {
  distrital: '#60a5fa', provincial: '#fbc02d', regional: '#4ade80', nacional: '#c084fc',
};
---

<VettingLayout title="Diagnóstico Territorial">
  <div style="margin-bottom:2.5rem;">
    <p style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.3em; text-transform:uppercase; color:#fbc02d; margin-bottom:0.75rem;">
      Herramienta · ECD — Estructura / Conciencia / Decisión
    </p>
    <h1 style="font-family:'Inter Tight',sans-serif; font-weight:900; font-size:2.2rem; letter-spacing:-0.025em; color:#f8fafc; line-height:1.1;">
      Diagnóstico Territorial
    </h1>
    <p style="font-size:0.9rem; color:#64748b; margin-top:0.5rem; line-height:1.6; max-width:520px;">
      Instrumento estructurado basado en el marco ECD (Bourdieu · Michigan School · Rational Choice). Segmentos psicográficos vinculados a matriz de decisión.
    </p>
    <div style="width:48px; height:3px; background:linear-gradient(90deg,#fbc02d,#ff9500); border-radius:2px; margin-top:1.25rem;"></div>
  </div>

  {items.length > 0 ? (
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:1rem; margin-bottom:2rem;">
      {items.map(({ slug, meta }) => (
        <a href={`/diagnostics/${slug}`} style="display:block; background:rgba(10,21,56,0.6); border:1px solid rgba(251,192,45,0.12); border-radius:12px; padding:1.4rem; transition:border-color 0.2s, transform 0.2s; text-decoration:none;"
          onmouseenter="this.style.borderColor='rgba(251,192,45,0.35)'; this.style.transform='translateY(-2px)'"
          onmouseleave="this.style.borderColor='rgba(251,192,45,0.12)'; this.style.transform='translateY(0)'">
          <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:0.5rem; margin-bottom:0.5rem;">
            <h2 style="font-family:'Inter Tight',sans-serif; font-weight:800; font-size:1.05rem; color:#f8fafc;">{meta.nombre_territorio}</h2>
            <span style={`font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; padding:0.2rem 0.5rem; border-radius:3px; flex-shrink:0; background:${NIVEL_COLOR[meta.nivel] ?? '#64748b'}22; color:${NIVEL_COLOR[meta.nivel] ?? '#64748b'};`}>
              {meta.nivel}
            </span>
          </div>
          <p style="font-size:0.78rem; color:#64748b; margin-bottom:0.5rem;">{meta.eleccion_cargo} · {meta.eleccion_año}</p>
          <p style="font-size:0.72rem; color:#334155;">{meta.fecha}</p>
        </a>
      ))}
    </div>
  ) : (
    <div style="background:rgba(10,21,56,0.4); border:1px solid rgba(251,192,45,0.08); border-radius:12px; padding:2rem; margin-bottom:2rem;">
      <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.25em; text-transform:uppercase; color:#334155; margin-bottom:0.75rem;">Sin diagnósticos aún</p>
      <p style="font-size:0.85rem; color:#475569; line-height:1.6;">
        Dile a Claude: <em style="color:#64748b;">"Nuevo diagnóstico territorial de [nombre del territorio]"</em>
      </p>
    </div>
  )}

  <div style="background:rgba(5,10,30,0.8); border:1px solid rgba(248,250,252,0.05); border-radius:12px; padding:1.5rem;">
    <p style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.3em; text-transform:uppercase; color:#334155; margin-bottom:1rem;">Cómo usar con Claude</p>
    <div style="display:flex; flex-direction:column; gap:0.6rem;">
      {[
        ['Nuevo diagnóstico', '"Nuevo diagnóstico territorial de [territorio] para [cargo] [año]"'],
        ['Completar sección', '"Agrega al diagnóstico de [territorio] — E2: IDH 0.71, pobreza 22%..."'],
        ['Ver estado', '"¿Qué falta completar en el diagnóstico de [territorio]?"'],
        ['Generar análisis', '"Genera los cruces ECD del diagnóstico de [territorio]"'],
        ['Reanalizar', '"Actualiza el análisis de [territorio] con los nuevos datos de encuesta"'],
      ].map(([cmd, phrase]) => (
        <div style="display:grid; grid-template-columns:160px 1fr; gap:1rem; align-items:start;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.15em; text-transform:uppercase; color:#475569; padding-top:0.1rem;">{cmd}</span>
          <span style="font-size:0.8rem; color:#64748b; font-style:italic;">{phrase}</span>
        </div>
      ))}
    </div>
  </div>
</VettingLayout>
